<Project>
  <PropertyGroup>
    <CoworkeeReferenceMode Condition="'$(CoworkeeReferenceMode)' == ''">Package</CoworkeeReferenceMode>
    <CoworkeeRoot Condition="'$(CoworkeeRoot)' == ''">$(MSBuildThisFileDirectory)..\coworkee\</CoworkeeRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(CoworkeeReferenceMode)' == 'Project'">
    <ProjectReference Include="@(CoworkeePackage->'$(CoworkeeRoot)src\%(Identity)\%(Identity).csproj')" IsAspireProjectResource="false" />
  </ItemGroup>
  <!-- the packages bring the application service generator as analyzer; project references have to add it themselves -->
  <ItemGroup Condition="'$(CoworkeeReferenceMode)' == 'Project' And ('@(CoworkeePackage->WithMetadataValue('Identity','Coworkee.AspNetCore'))' != '' Or '@(CoworkeePackage->WithMetadataValue('Identity','Coworkee.Client.Blazor'))' != '')">
    <ProjectReference Include="$(CoworkeeRoot)src\Coworkee.SourceGenerators\Coworkee.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" IsAspireProjectResource="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(CoworkeeReferenceMode)' != 'Project'">
    <PackageReference Include="@(CoworkeePackage)" />
  </ItemGroup>
  <!-- the packages bring build targets (ICU data for the Blazor client, codegen.json); project references import them here -->
  <Import Project="$(CoworkeeRoot)src\Coworkee.Client.Blazor\build\Coworkee.Client.Blazor.targets" Condition="'$(CoworkeeReferenceMode)' == 'Project' And Exists('$(CoworkeeRoot)src\Coworkee.Client.Blazor\build\Coworkee.Client.Blazor.targets')" />
  <Import Project="$(CoworkeeRoot)src\Coworkee.CodeGen\build\Coworkee.CodeGen.targets" Condition="'$(CoworkeeReferenceMode)' == 'Project' And Exists('$(CoworkeeRoot)src\Coworkee.CodeGen\build\Coworkee.CodeGen.targets')" />
  <!-- several modules generate DTOs: Nextended.CodeGen 10.1.51 shares its generator between the compilations of one compiler server, so modules built in parallel
       write into each other's folders. Own compiler process per module; Coworkee.CodeGen does this itself after 0.0.1.74, then this group can go. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\codegen.json')">
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
</Project>
