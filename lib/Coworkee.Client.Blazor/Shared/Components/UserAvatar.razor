@using Coworkee.Application.Common.Extensions
@inject Microsoft.Extensions.Localization.IStringLocalizer<UserAvatar> _localizer
@implements IAsyncDisposable

<div @onclick="GotoAccountOrProfile" class="@(CanNavigateToProfile() ? "cursor-pointer" : "") mud-button-text mud-button-text-size-medium">
    @if (IsUserOnline.HasValue)
    {
        <MudTooltip Text="@ToolTipText()" Color="@(IsUserOnline.Value ? Color.Success : Color.Error)">
            <MudBadge Class="my-2 user-online-badge" Color="@(IsUserOnline.Value ? Color.Success : Color.Error)" Style="width:100%" Origin="Origin.BottomRight" Overlap="true">
                @RenderAvatarImage()                
            </MudBadge>
        </MudTooltip>
    }
    else
    {
        @RenderAvatarImage()
    }

</div>


@code {

    RenderFragment RenderAvatarImage()
    {
        var mail = User?.GetEmail() ?? UserData?.Email;
        @if (string.IsNullOrEmpty(ImageDataUrl) && NoImageHandling == NoImageHandling.ShowGravatar && !string.IsNullOrEmpty(mail))
        {
            return @<MudExGravatar Style="@StyleStr()" Email="@mail" />;
        }
        return @<MudAvatar Style="@StyleStr()">
            @if(string.IsNullOrEmpty(ImageDataUrl)){
                <p>@Initials?.ToUpper()</p>
            }else{
                <MudImage ObjectFit="ObjectFit.Contain" Src="@ImageDataUrl" Alt="@mail"></MudImage>
            }
        </MudAvatar>;
    }
}
