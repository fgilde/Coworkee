<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
using System.Globalization;

namespace Coworkee.Shared;

<# var filesSubClassName = "Names";#>
public partial class EmailTemplate
{    
    public static class <#= filesSubClassName #>
    {
    <#
    var allFiles = Directory.GetFiles(Host.ResolvePath("Resources\\Emails"), "*.cshtml", SearchOption.AllDirectories).Select(f => Path.GetFileName(f)).Distinct();
    
    foreach (var file in allFiles)
    {
        var fileName = Path.GetFileNameWithoutExtension(file);
        var safeFileName = fileName.Replace("-", "").Replace("_", "");
    #>
    public const string <#= safeFileName #> = "<#= file #>";      
    <#
    }
    #>}

    <#
    foreach (var file in allFiles)
    {
        var fileName = Path.GetFileNameWithoutExtension(file);
        var safeFileName = fileName.Replace("-", "").Replace("_", "");
    #>
public static EmailTemplate <#= safeFileName #>(CultureInfo culture = null) => Get(<#= filesSubClassName #>.<#= safeFileName #>, culture); 
    public static EmailTemplate <#= safeFileName #>(string culture) => Get(<#= filesSubClassName #>.<#= safeFileName #>, culture); 
    <#
    }
    #>
    
    // Nested classes for each culture
    <#
    var directories = Directory.GetDirectories(Host.ResolvePath("Resources\\Emails"));
    foreach (var dir in directories)
    {
        var cultureName = Path.GetFileName(dir).Replace("-", "_");
        var files = Directory.GetFiles(dir, "*.cshtml").Select(Path.GetFileName).Distinct();
    #>
public static class <#= cultureName.ToUpper() #>
    {
        <# foreach (var file in files) {
            var fileName = Path.GetFileNameWithoutExtension(file);
            var safeFileName = fileName.Replace("-", "").Replace("_", "");
        #>
    public static EmailTemplate <#= safeFileName #> => Get(EmailTemplate.<#= filesSubClassName #>.<#= safeFileName #>, "<#= cultureName.Replace("_", "-") #>");
        <# 
        }
        #>

    }

    <#
    }
    #>
    
}