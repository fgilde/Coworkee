@{
    Layout = "Layout";
}

<h1>Passwort Zurücksetzen</h1>
<br/>
Hallo @Model.User.FirstName, falls Sie Ihr Passwort vergessen haben,
bitte setzen Sie Ihr Passwort zurück, indem Sie <a href=@Model.PasswordResetUrl>hier klicken</a>.

<br/>
<br/>

<div class="container">
    <a class="btn" href="@Model.PasswordResetUrl">Passwort Zurücksetzen</a>
</div>