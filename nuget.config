<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="coworkee-local" value="../coworkee/artifacts/nuget" />
    <!-- Nextended 10.1.43-codegen.1 (Mapperly mapping strategy) packed locally until Nextended 10.1.43 is released -->
    <add key="nextended-local" value="../nextended-nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="coworkee-local">
      <package pattern="Coworkee.*" />
    </packageSource>
    <packageSource key="nextended-local">
      <package pattern="Nextended.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Nextended.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
