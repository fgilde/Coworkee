@page "/admin/database-backups"
@using Coworkee.Shared.Constants.Role
@attribute [Authorize(Roles = RoleConstants.AdministratorRole)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Database> _localizer
@using Coworkee.Shared.Wrapper
@using Coworkee.Application.Common.Models


<ReactOnPreferenceChanged Component="this" />
<PageHeaderTitle Title="@_localizer["Database Backups"]" Description="@_localizer["Manage Database Backups."]" />

<EditableDataTable 
    TIdType="string"
    TResult="DatabaseBackupDto"
    ApiLoadPaged="@(Load)"
    ApiDelete="@(new Func<string[], Task<Result>>(Delete))"
    ApiCreateOrEdit="@(new Func<DatabaseBackupDto, Task<bool>>(CreateOrEdit))"
    GetById="@(new Func<string, IEnumerable<DatabaseBackupDto>, Task<DatabaseBackupDto>>(FindById))"
    GetId="@(new Func<DatabaseBackupDto,string>(GetId))"
    Display="@(new Func<DatabaseBackupDto, string>(GetName))"
    TableProperties="@(new []{nameof(DatabaseBackupDto.Name), nameof(DatabaseBackupDto.FileSize), nameof(DatabaseBackupDto.CreatedOn)})"
    InitialAction="@Action"
    InitialIdString="@Id"
    CustomActions="@GetCustomActions()"
    CreatePermission="@Permissions.Backups.Create"
                   DeletePermission="@Permissions.Backups.Delete"
                   EditPermission="@Permissions.Backups.Edit"
    SearchPermission="@Permissions.Backups.Search">
</EditableDataTable>