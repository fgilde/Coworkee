@attribute [Route(ApplicationConstants.Routes.Login)]
@attribute [Route($"{ApplicationConstants.Routes.Login}/{{Message}}")]
 
@using Coworkee.Shared.Constants.Application
@using Coworkee.Client.Utils
@layout LoginLayout
@attribute [AllowAnonymous]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Login> _localizer
<ReactOnPreferenceChanged Component="this" />
@*<PageTitle>@_localizer["Sign In"]</PageTitle>*@

@if (!string.IsNullOrEmpty(_message))
{
    <MudAlert Class="top-alert" ShowCloseIcon="true" CloseIconClicked="() => SetMessage(null, Severity.Info)" ContentAlignment="HorizontalAlignment.Center" Severity="@_messageSeverity">@((MarkupString)_message)</MudAlert>
}

<EditForm Model="@_tokenModel" OnValidSubmit="SubmitAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator" />
    @* <MudGrid Style="@($"animation: {new [] {AnimationType.Zoom}.GetAnimationCssStyle(TimeSpan.FromMilliseconds(250))}")">*@
    <MudGrid>
        <MudItem xs="12">
            <div class="d-flex justify-center">
                <ApplicationLogo />
            </div>
        </MudItem>
        <DataAnnotationsValidator />
        <MudItem xs="12">
            <div class="d-flex justify-center">
                <MudText Typo="Typo.h4">@_localizer["Sign In"]</MudText>
            </div>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex justify-center">
                <MudText>@_localizer["LoginDescription"]</MudText>
            </div>
        </MudItem>
        @if (_config?.ServerConfiguration?.UserRegistration?.Enabled == true)
        {
            <MudItem xs="12">
                <div class="d-flex justify-center">
                    <MudText>@_localizer["Don't have an account?"] <MudLink Href="@ApplicationConstants.Routes.Register">@_localizer["Register here"]</MudLink></MudText>
                </div>
            </MudItem>
        }
        <MudItem xs="12">
            <MudTextField InputId="email" T="string" Label="@GetEmailLabel()" Variant="Variant.Outlined"
                          @bind-Value="_tokenModel.Email" For="@(() => _tokenModel.Email)" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField InputId="password" Label="@_localizer["Password"]" Variant="Variant.Outlined"
                          @bind-Value="_tokenModel.Password" For="@(() => _tokenModel.Password)"
                          UserAttributes="@( new (){{"autocomplete", "current-password"}})"
                          InputType="@_passwordInput" Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="TogglePasswordVisibility" />
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-space-between align-center">
            <MudCheckBox T="bool" Label="@_localizer["Remember me?"]" Color="Color.Primary" Class="ml-n1"></MudCheckBox> <MudLink Href="@($"/account/forgot-password?email={_tokenModel.Email}")">@_localizer["Forgot password?"]</MudLink>
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-center">
            <MudButton Class="btn-login" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Disabled="@(!Validated || _processing)" Color="Color.Primary" Size="Size.Large" Style="width: 100%;">
                @if (_processing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">@_localizer["Please Wait"]</MudText>
                }
                else
                {
                    <MudText>@_localizer["Sign In"]</MudText>
                }
            </MudButton>
        </MudItem>
        @if (!_processing && _config?.ServerConfiguration?.KeycloakEnabled == true)
        {
            <MudItem xs="12" Class="d-flex justify-center">
                <MudLink Href="@(KeyCloakHref())">@_localizer["Login with Keycloak"]</MudLink>
            </MudItem>
        }

        @if(Debug.IsDebug()){
            @if (ApplicationConstants.Defaults.Users.Administrators.Any())
            {
                <MudItem xs="12">
                    <MudButton OnClick="FillAdministratorCredentials">@_localizer["Fill Administrator Credentials"]</MudButton>
                </MudItem>
            }
            @if (ApplicationConstants.Defaults.Users.Basic.Any())
            {
                <MudItem xs="12">
                    <MudButton OnClick="FillBasicUserCredentials">@_localizer["Fill Basic User Credentials"]</MudButton>
                </MudItem>
            }
        }
    </MudGrid>
</EditForm>

@code{

    private string KeyCloakHref()
    {
        var redirectPageUri = _navigationManager.ToAbsoluteUri($"/{ApplicationConstants.Routes.Redirect}");
        var currentReturnUrlValue = _navigationManager.GetReturnUrlValue(true);
        var escapeDataString = !string.IsNullOrWhiteSpace(currentReturnUrlValue) ? Uri.EscapeDataString(currentReturnUrlValue) : currentReturnUrlValue;
        if(string.IsNullOrWhiteSpace(escapeDataString))
            escapeDataString = "/";
        var returnUrl = $"{redirectPageUri}?{ApplicationConstants.ParameterNames.ReturnUrl}={escapeDataString}";
        return $"{_config.BackendOrigin}/api/v1/identity/account/login?returnUrl={returnUrl}"; // Notice keyname returnUrl is a backend parameter so we dont use constants here
    }
}
