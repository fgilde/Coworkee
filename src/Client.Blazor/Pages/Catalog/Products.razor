@page "/catalog/products/{Action?}/{Id?}"
@attribute [Authorize(Policy = Permissions.Products.View)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Products> _localizer
@using Coworkee.Application.Common.Models
@using Coworkee.Application.Contracts.Enums


<ReactOnPreferenceChanged Component="this" />
<PageHeaderTitle Title="@_localizer["Products"]" Description="@_localizer["Manage Products."]" />

<EditableDataTable
    TIdType="string"
    TResult="ProductDto"
    ApiLoadPaged="@(Load)"
    ApiDelete="@(DeleteProducts)"
    ApiCreateOrEdit="@(CreateOrEditProduct)"
    Export="@(new Func<ExportServiceType, string, Task>(Export))"
    ExportSelected="@(new Func<ExportServiceType, string[], Task>(ExportSelected))"
    GetById="@(FindById)"
    GetId="@(GetId)"
    Display="@(GetName)"
    TableProperties="@(new []{nameof(ProductDto.Id), nameof(ProductDto.Name), nameof(ProductDto.Brand), nameof(ProductDto.Description), nameof(ProductDto.Barcode), nameof(ProductDto.Rate)})"
    InitialAction="@Action"
    InitialIdString="@Id"
    CreatePermission="@Permissions.Products.Create"
    DeletePermission="@Permissions.Products.Delete"
    EditPermission="@Permissions.Products.Edit"
    ExportPermission="@Permissions.Products.Export"
    SearchPermission="@Permissions.Products.Search"
>
</EditableDataTable>
