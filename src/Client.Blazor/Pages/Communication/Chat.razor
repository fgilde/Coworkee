@page "/chat/{CId}"
@page "/chat"
@using System.Globalization
@using Coworkee.Application.Common.Models.Identity
@attribute [Authorize(Policy = Permissions.Communication.Chat)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Chat> _localizer

<ReactOnPreferenceChanged Component="this" />
<div class="d-flex flex-grow-1 flex-row">
    <MudPaper Elevation="25" Class="py-4 flex-grow-1">
        <MudToolBar Dense="true">

            @if (string.IsNullOrEmpty(CId))
            {
                <MudIcon Icon="@Icons.Material.Outlined.Person" Style="margin-right:10px">  </MudIcon>
                <MudText Typo="Typo.h6">@_localizer["chat"]</MudText>
            }
            else
            {
                <UserAvatar UserId="@CId"></UserAvatar>
                <MudText Typo="Typo.h6">@CFullName</MudText>
            }

            <MudSpacer />
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudIconButton OnClick="@(() => OpenDrawer(Anchor.Right))" Icon="@Icons.Material.Outlined.PeopleAlt" Color="Color.Inherit" Class="ml-3" />
            </MudHidden>
        </MudToolBar>
        <div class="d-flex flex-column px-4" style="max-height:75vh;min-height:75vh; overflow:scroll;" id="chatContainer">
            @foreach (var message in _messages)
            {
                <div class="d-flex @(message.FromUserId == CurrentUserId ? "flex-row-reverse" : "flex-row") my-4">
                    @*My messages to right with flex-row-reverse*@
                    <div class="mr-4">
                        <UserAvatar UserId="@message.FromUserId" />
                    </div>
                    <div>
                        <MudText Typo="Typo.body1">@message.FromUserFullName</MudText>
                            <MudText Typo="Typo.caption" Style="font-size: xx-small!important;">@message.CreatedDate.ToString("G", CultureInfo.CurrentCulture)</MudText>
                            <div style="display: flex; align-items: center; justify-content: space-between;">
                                <MudText Typo="Typo.body2" Style="padding: 15px; background-color: var(--mud-palette-background-grey); border-radius: 5px; margin-top: 5px">
                                    @Linkify(message.Message)
                            </MudText>
                            <MudExIconButton OnClick="@(() => DeleteMessage(message))" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" ToolTip="@_localizer["Delete"]" Visible="@(message.FromUserId == CurrentUserId && !IsDeleting(message))"></MudExIconButton>
                            @if (IsDeleting(message))
                            {
                                <MudProgressCircular Style="margin-left: 5px;" Indeterminate="false" Max="1" Value="@DeletionProgress(message.Id)" />
                                <MudExIconButton OnClick="@(() => DeleteMessage(message))" Style="margin-left: -44px" ToolTip="@_localizer["Cancel deletion"]" Icon="@Icons.Material.Filled.Cancel" Color="Color.Warning"></MudExIconButton>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <MudPaper Elevation="25" Class="d-flex flex-row px-2 mx-4" Style="">
            @* <MudExRichTextEdit @onkeydown="OnKeyDownInChat" @onkeypress="OnKeyPressInChat" Placeholder="@_localizer["Enter your message..."]" Immediate="true" For="@(()=> CurrentMessage)" @bind-Value="CurrentMessage"></MudExRichTextEdit> *@
            <MudTextField T="string" Placeholder="@_localizer["Enter your message..."]" Immediate="true" Lines="3" @onkeydown="OnKeyDownInChat" @onkeypress="OnKeyPressInChat" DisableUnderLine="true"
                          @bind-Value="CurrentMessage" For="@(()=> CurrentMessage)" />
            <MudButton OnClick="SubmitAsync" Disabled="@string.IsNullOrWhiteSpace(CId)" StartIcon="@Icons.Material.Outlined.Send" Color="Color.Secondary" ButtonType="ButtonType.Button">@_localizer["Send"]</MudButton>

            </MudPaper>
        </MudPaper>
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudPaper Elevation="25" Class="pa-3 ml-6" MinWidth="350px">
                <MudToolBar Dense="true">
                    <MudText Typo="Typo.h6">@_localizer["contacts"]</MudText>
                </MudToolBar>
                <div class="d-flex flex-column px-4" style="max-height:75vh;min-height:75vh; overflow:scroll;">
                <MudList T="ChatUserResponse" Clickable="true">
                        @foreach (var user in UserList)
                    {
                        <MudListItem Disabled="@(user.Id == CId)" Class="@($"pa-0 px-2 {(user.Id == CId ? "primary-border" : "")}")" OnClick="@(() => LoadUserChat(user.Id))">
                            <UserCard Class="pa-0" IsUserOnline="@user.IsOnline" UserId="@user.Id" />
                        </MudListItem>
                    }
                </MudList>
            </div>
        </MudPaper>
    </MudHidden>
</div>
<MudDrawer @bind-Open="@_open" Anchor="@ChatDrawer" Elevation="1" Variant="@DrawerVariant.Temporary">
    <div class="pa-3">
        <MudList T="ChatUserResponse" Clickable="true">
            @foreach (var user in UserList)
            {
                <MudListItem Class="pa-0 px-2" OnClick="@(() => LoadUserChat(user.Id))">
                    <UserCard IsUserOnline="@user.IsOnline" UserId="@user.Id" />
                </MudListItem>
            }
        </MudList>
    </div>
</MudDrawer>