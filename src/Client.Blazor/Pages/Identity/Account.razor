@page "/account"
@page "/account/{Action?}/{Id?}"
@using Coworkee.Shared.Constants.Application
@using Coworkee.Application.Common.Extensions
@using Coworkee.Client.JsInterop
@inject Microsoft.Extensions.Localization.IStringLocalizer<Account> localizer

<ReactOnPreferenceChanged Component="this" />
<PageHeaderTitle Title="@localizer["Account"]" Description="@localizer["Manage your account"]" />
<MudTabs ActivePanelIndexChanged="@PanelIndexChanged" ActivePanelIndex="@GetActivePanelIndex()" Elevation="25" Color="Color.Transparent" Rounded="true" PanelClass="mt-6 full-height" Style="height: 100%">
    <MudTabPanel Text="@localizer["Profile"]">
        <Profile Variant="Variant.Outlined" />
    </MudTabPanel>
    <MudTabPanel Text="@localizer["Security"]">
        <Security />
    </MudTabPanel>
    <MudTabPanel Text="@localizer["Notifications"]" Style="height:100%">
        <NotificationsList Id="@Id"></NotificationsList>
    </MudTabPanel>
    <AuthorizeView Policy="@Permissions.Documents.View">
        <MudTabPanel Text="@localizer["Documents"]">
            <DocumentList UserId="@userId"></DocumentList>
        </MudTabPanel>
    </AuthorizeView>
</MudTabs>

@code
{
    [Parameter] public string Action { get; set; }
    [Parameter] public string Id { get; set; }
    private string userId;
    
    private readonly Dictionary<int, string> _pages = new()
    {
        { 0, "" },
        { 1, "security" },
        { 2, "notifications" },
        { 3, "documents" }
    };
    
    private int GetActivePanelIndex() => _pages.ContainsValue(Action) ? _pages.FirstOrDefault(x => x.Value == Action).Key : 0;
    private async void PanelIndexChanged(int index) => await _jsRuntime.InvokeVoidAsync(JsNamespace.Get("BrowserHelper", "changeUrl"), $"/account/{Action = _pages[index]}/{Id}");

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await _stateProvider.GetAuthenticationStateAsync();
        userId = authenticationState.User.GetUserId();
        if (authenticationState.IsGuest())
        {
            _navigationManager.NavigateTo($"{ApplicationConstants.Routes.Forbidden}/{Uri.EscapeDataString(_navigationManager.ToBaseRelativePath(_navigationManager.Uri))}");
        }
    }

}
