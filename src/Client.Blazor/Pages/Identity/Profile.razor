@inject Microsoft.Extensions.Localization.IStringLocalizer<Profile> _localizer

<ReactOnPreferenceChanged Component="this" />

<MudGrid>
    <MudItem xs="12" sm="4" md="3">
        <MudCard Elevation="25">
            <MudCardContent>
                <InputFile @ref="inputFile" id="fileInput" hidden OnChange="UploadFiles" />
                <div class="d-flex justify-center mb-4 drop-zone" @ref="dropZoneElement">
                    <UserAvatar UserData="@user" Height="250" Width="250" />
                </div>
                <MudText Style="word-wrap:break-word"Typo="Typo.h6" Align="Align.Center">@user?.FirstName @user?.LastName</MudText>
                <MudText Style="word-wrap:break-word" Align="Align.Center">@user?.Email</MudText>
            </MudCardContent>
            @if (_canEditUser)
            {
                <MudCardActions Class="d-flex justify-center">
                    <MudButton HtmlTag="label"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           for="fileInput">
                        <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
                            @_localizer["Upload Image"]
                        </MudHidden>
                    </MudButton>
                    @if (!string.IsNullOrEmpty(@ImageDataUrl))
                    {
                        <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           OnClick="DeleteAsync">
                            <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
                                @_localizer["Delete Image"]
                            </MudHidden>
                        </MudButton>
                    }
                </MudCardActions>
            }
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="8" md="9">
        @if (user != null)
        {
            <EditForm Model="@user" OnValidSubmit="UpdateProfileAsync">
                <FluentValidationValidator @ref="_fluentValidationValidator" />
                <MudCard Elevation="25">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText>@_localizer["Profile Details"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudTextField ReadOnly="@(!_canEditUser || !_config.ServerConfiguration.UserRegistration.UsernameRules.UsernameCanChangedAfterRegistration && !_canEditUserAsAdmin)" @bind-Value="@user.UserName" For="@(() => user.UserName)" Label="@_localizer["UserName"]" Variant="@Variant" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField ReadOnly="@(!_canEditUser)" @bind-Value="@user.FirstName" For="@(() => user.FirstName)" Label="@_localizer["First Name"]" Variant="@Variant" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField ReadOnly="@(!_canEditUser)" @bind-Value="@user.LastName" For="@(() => user.LastName)" Label="@_localizer["Last Name"]" Variant="@Variant" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField ReadOnly="@(!_canEditUser)" @bind-Value="@user.PhoneNumber" For="@(() => user.PhoneNumber)" Label="@_localizer["Phone Number"]" Variant="@Variant" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField ReadOnly="@(!_canEditUser || !_config.ServerConfiguration.UserRegistration.UsernameRules.EmailCanChangedAfterRegistration && !_canEditUserAsAdmin)" @bind-Value="@user.Email" For="@(() => user.Email)" Label="@_localizer["Email"]" Variant="@Variant" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>

                </MudCard>

                <MudCard Class="my-5" Elevation="25">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText>@_localizer["Address"]</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <AddressEdit Variant="@Variant" ReadOnly="@(!_canEditUser)" AddressCreated="@(OnAddressCreated)" Address="@user.UserInfo?.Addresses?.FirstOrDefault()"></AddressEdit>
                    </MudCardContent>
                </MudCard>

                @if (_canEditUser)
                {
                    <MudGrid Class="app-sticky-bottom-actionbar-body">
                        <MudButton Disabled="@(!Validated)" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto mr-3 mt-5" ButtonType="ButtonType.Submit">@_localizer["Save Changes"]</MudButton>
                    </MudGrid>
                }

            </EditForm>
        }
    </MudItem>
</MudGrid>
