@page "/user-profile/{Id}"
@attribute [Authorize(Policy = Permissions.Users.View)]

@inject Microsoft.Extensions.Localization.IStringLocalizer<UserProfile> _localizer

<ReactOnPreferenceChanged Component="this" />
<PageHeaderTitle Title="@Title" Description="@Description" />

<MudTabs Elevation="25" Color="Color.Transparent" Rounded="true" PanelClass="mt-6">
    <MudTabPanel Text="@_localizer["Profile"]">
        <MudGrid>
            <AuthorizeView Policy="@Permissions.Users.Edit">
                @if (user != null)
                {
                    <MudItem xs="12" sm="12" md="12">
                        <MudCard Elevation="25">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.body1">@_localizer["Administrator Settings."]</MudText>
                                    <MudText Typo="Typo.body2">@_localizer["This is an Administrator Only View."]</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pa-46" Style="padding: 26px !important">
                                <MudGrid>
                                    <MudCheckBox @bind-Value="@user.IsActive" Label="@_localizer["Active?"]" Color="Color.Primary"></MudCheckBox>
                                    <MudCheckBox Class="ml-5" @bind-Value="@user.EmailConfirmed" Label="@_localizer["Email Confirmation"]" Color="Color.Primary"></MudCheckBox>
                                    <MudButton Style="align-self: center" Variant="Variant.Outlined" Color="Color.Error" Class="ml-5" OnClick="LogoutUser" ButtonType="ButtonType.Submit">@_localizer["Logout user"]</MudButton>
                                    <MudButton Style="align-self: center" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="ToggleUserStatus" ButtonType="ButtonType.Submit">@_localizer["Save Changes"]</MudButton>
                                </MudGrid>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </AuthorizeView>
        </MudGrid>
        <Profile UserId="@Id"></Profile>
    </MudTabPanel>
    <AuthorizeView Policy="@Permissions.Documents.View">
        <MudTabPanel Text="@_localizer["Documents"]">
            <DocumentList CanCreate="false" UserId="@Id"></DocumentList>
        </MudTabPanel>
    </AuthorizeView>
</MudTabs>