@using Coworkee.Application.Common.Models
@inject Microsoft.Extensions.Localization.IStringLocalizer<DeleteConfirmation> localizer


<MudExSplitPanel UpdateSizesInPercentage="true" Splittable="true" ColumnLayout="false" Style="width: 100%; height: 100%">
    <Left>
        <MudExSplitPanelItem Style="width: 50%; min-width:350px; height: 80%; min-height:100px;">
            <div style="height: 100%; overflow: auto" id="assistantChatContainer">
                @if (Messages?.Any() == true)
                {
                    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start" Reverse="false">
                        @foreach (var message in Messages)
                        {
                            <MudTimelineItem Size="Size.Small" Color="@message.Color" Variant="@message.Variant">
                                <ItemDot>
                                    @if (!message.Completed)
                                    {
                                        <MudProgressCircular Color="Color.Secondary" Size="Size.Small" Indeterminate="true"/>
                                    }
                                    else
                                    {
                                        <MudIcon Size="Size.Small" Icon="@(message.Owner == AssistantCommandOwner.Assistant ? Icons.Material.Filled.Assistant : Icons.Material.Filled.People)" />
                                    }
                                </ItemDot>
                                <ItemContent>
                                    <MudAlert Severity="@message.Severity">
                                        @if (!message.Completed)
                                        {
                                            <MudProgressLinear Color="@message.Color" Size="Size.Small" Indeterminate="true"/>
                                        }
                                        @message.Message
                                    </MudAlert>
                                </ItemContent>
                                <ItemOpposite>
                                    <MudText Color="@message.Color">@message.Owner</MudText>
                                </ItemOpposite>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                }
            </div>
        </MudExSplitPanelItem> 
    </Left>
    <Right>
        <MudExSplitPanelItem Style="width: 50%; min-width:350px; height: 20%; min-height:100px;">
            <MudPaper Elevation="0" Class="d-flex flex-row px-2 mx-4" Style="flex-grow: 2">
                <MudTextField T="string"  Placeholder="@localizer["Enter your message..."]" AutoFocus="true" Immediate="true" Lines="4" @onkeydown="OnKeyDownInChat" @onkeyup="OnKeyUpInChat" DisableUnderLine="true"
                              @bind-Value="CurrentMessage" For="@(() => CurrentMessage)" />
                <MudButton OnClick="SubmitAsync" Disabled="@(!_canSubmit)" StartIcon="@Icons.Material.Outlined.Send" Color="Color.Secondary" ButtonType="ButtonType.Button"></MudButton>
            </MudPaper>
        </MudExSplitPanelItem>
    </Right>
</MudExSplitPanel>
