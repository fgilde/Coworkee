@using Coworkee.Client.Theming
@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="@(_theme?.PreferDarkMode == true)" Theme="@_theme" />
<MudSnackbarProvider />
<MudDialogProvider />
<MudPopoverProvider />
<MudAppBar Elevation="4">
    <MudSpacer />
    <LanguageSelector />
    <ThemeSelector OnThemeSelected="@ThemeChanged" ToggleOnly="true"/>
</MudAppBar>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 100vh;">
    <MudPaper Elevation="25" Class="pa-8">
        @Body
    </MudPaper>
</MudContainer>

@code
{
    ClientTheme _theme = ClientThemes.LastUsedTheme ?? ClientThemes.DefaultTheme;
    private void ThemeChanged(ClientTheme theme)
    {
        StateHasChanged();
    }
}
