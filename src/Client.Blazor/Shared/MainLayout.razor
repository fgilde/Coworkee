@inherits LayoutComponentBase
@inject Microsoft.Extensions.Localization.IStringLocalizer<MainLayout> localizer

<CascadingValue Value="this" IsFixed="true">
    <CascadingValue Value="CurrentUser">
        <audio id="notification" src="/media/notification.mp3" />
        <ReactOnPreferenceChanged Component="this" OnPreferenceChanged="@OnPreferenceChanged" />
        <MudRTLProvider RightToLeft="@RightToLeft">
            <MudThemeProvider IsDarkMode="@IsDarkMode" Theme="CurrentTheme" />
            <MudDialogProvider />
            <MudSnackbarProvider />
            <MudPopoverProvider />

            <MudLayout>
                <MainAppBar />
                <MainNavMenuDrawer @ref="NavMenuDrawer" @bind-Open="IsDrawerOpen" Elevation="25" />
                <MudMainContent>
                    <MudContainer MaxWidth="MaxWidth.False" Class="app-main-container mt-4">
                        @Body
                    </MudContainer>
                </MudMainContent>
            </MudLayout>
        </MudRTLProvider>
    </CascadingValue>
</CascadingValue>