@page "/register"
@using Coworkee.Shared.Constants.Application
@using MimeTypeRestrictionType = Coworkee.Client.Shared.Components.MimeTypeRestrictionType
@layout LoginLayout
@attribute [AllowAnonymous]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Register> _localizer
<ReactOnPreferenceChanged Component="this" />
<EditForm @onkeypress="@(NavigateToNextPageOrPost)" Model="@_registerUserModel" OnValidSubmit="SubmitAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator" />

    <MudGrid>
        <MudItem xs="12">
            <div class="d-flex justify-center">
                <ApplicationLogo />
            </div>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex justify-center">
                <MudText Typo="Typo.h4">@_localizer["Register"]</MudText>
            </div>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex justify-center">
                <MudText>@_localizer["Already have an account?"] <MudLink Href="@ApplicationConstants.Routes.Login">@_localizer["Sign In"]</MudLink></MudText>
            </div>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex justify-center">
                <MudMenu Class="page-selection-menu" Label="@(SelectedPageIndex <= _pages.Count -1 ? _localizer[_pages[SelectedPageIndex]] : "" )" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.CenterCenter" Color="Color.Secondary" OffsetY="true" Dense="true">
                    @{
                        foreach (var item in _pages)
                        {
                            <MudMenuItem OnClick="@(() => SelectedPageIndex = Array.IndexOf(_pages.ToArray(), item))">
                                <MudText Typo="Typo.h6">
                                    @_localizer[item]
                                </MudText>
                            </MudMenuItem>
                        }
                    }
                </MudMenu>
            </div>
        </MudItem>
    </MudGrid>


    <MudCarousel Class="mud-width-full" Style="height: 50vh;" @bind-SelectedIndex="SelectedPageIndex" ShowArrows="@(_pages.Count > 1)" ArrowsPosition="Position.Bottom" ShowBullets="@(_pages.Count > 1)" AutoCycle="false" TData="object">
        @{
            AddPage("User Data");
        }
        <MudCarouselItem Style="padding: 10px" Transition="Transition.Slide">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField AutoFocus="true" For="@(() => _registerUserModel.UserName)" @bind-Value="_registerUserModel.UserName" Label="@_localizer["User Name"]" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudTextField For="@(() => _registerUserModel.FirstName)" @bind-Value="_registerUserModel.FirstName" Label="@_localizer["First Name"]" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudTextField For="@(() => _registerUserModel.LastName)" @bind-Value="_registerUserModel.LastName" Label="@_localizer["Last Name"]" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudTextField T="string" Label="@_localizer["E-mail"]" @bind-Value="_registerUserModel.Email" For="@(() => _registerUserModel.Email)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudTextField T="string" Label="@_localizer["Phone Number"]" @bind-Value="_registerUserModel.PhoneNumber" For="@(() => _registerUserModel.PhoneNumber)" />
                </MudItem>

                <MudItem xs="12" sm="6" md="6">
                    <MudTextField For="@(() => _registerUserModel.Password)" InputType="@_passwordInput" UserAttributes="@(new() {{"autocomplete", "new-password"}})" Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="TogglePasswordVisibility" @bind-Value="_registerUserModel.Password" Label="@_localizer["Password"]" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudTextField For="@(() => _registerUserModel.ConfirmPassword)" InputType="InputType.Password" @bind-Value="_registerUserModel.ConfirmPassword" Label="@_localizer["Confirm Password"]" />
                </MudItem>
            </MudGrid>
        </MudCarouselItem>

        @if (_config?.ServerConfiguration?.UserRegistration?.RequireAddress == true)
        {
            AddPage("Address");
            <MudCarouselItem Style="padding: 10px" Transition="Transition.Slide">
                <AddressEdit Address="@_address"></AddressEdit>
            </MudCarouselItem>
        }

        @if (_config?.ServerConfiguration?.UserRegistration?.RequireDocuments == true)
        {
            AddPage("Qualifications and References");
            <MudCarouselItem Style="padding: 10px" Transition="Transition.Slide">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField DisableUnderLine="true" Class="disable-pointer-events-on-next-input" Adornment="Adornment.None" ReadOnly="true" For="@(() => _registerUserModel.Documents)" Label="@_localizer["Upload Qualifications and References"]" AdornmentIcon="@Icons.Filled.CloudUpload" OnAdornmentClick="Upload" />
                        <MudText Typo="Typo.caption">@_localizer["Please upload your personal qualifications and references that confirm your person and qualification"]</MudText>
                        <MudDivider></MudDivider>
                        <UploadRequestEdit @ref="_uploadEdit"
                                       MaxFileSize="@_config?.ServerConfiguration?.UserRegistration?.RegistrationDocumentsMaxFileSize"
                                       MimeTypes="@_config?.ServerConfiguration?.UserRegistration?.RegistrationDocumentTypes"
                                       MimeRestrictionType="MimeTypeRestrictionType.WhiteList"
                                       ShowFileUploadButton="true"
                                       UploadRequestRemoved="@(StateHasChanged)"
                                       Style="margin-top: 5px;"
                                       MaxHeight="350"
                                       @bind-UploadRequests="_registerUserModel.Documents">
                        </UploadRequestEdit>
                    </MudItem>
                </MudGrid>
            </MudCarouselItem>
        }

        @if (_selectableRoles?.Any() == true)
        {
            AddPage("Register as");
            <MudCarouselItem Style="padding: 10px" Transition="Transition.Slide">
                <MudGrid Style="padding:5px; max-height: 90%; overflow-y: auto; overflow-x: hidden;" Spacing="2">
                    @foreach (var role in _selectableRoles)
                    {
                        <MudItem xs="12">
                            <MudCard @onclick="@(() => ToggleRole(role))" Class="cursor-pointer animate-all-properties hover-scale hover-box-shadow"  Outlined="true">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Color="Color.Primary">@_localizer[role.Name]</MudText>
                                    <MudText Typo="Typo.body2">@_localizer[role.Description ?? ""]</MudText>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudCheckBox T="bool" CheckedChanged="@(() => ToggleRole(role))" Checked="@IsAddedAsInitialRole(role)" Label="@_localizer["Register as {0}", _localizer[role.Name]]" Color="Color.Primary"></MudCheckBox>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudCarouselItem>
        }

    </MudCarousel>


    <MudGrid>
        <MudItem xs="12" Class="d-flex justify-center">

            @if (_pages.Count > 1 && SelectedPageIndex < _pages.Count - 1 && (!Validated || !AllPagesVisited) && !_processing)
            {
                <MudButton Variant="Variant.Filled" OnClick="@(() => SelectedPageIndex++)" Color="Color.Primary" Size="Size.Large" Style="width: 100%;">
                    <MudText>@_localizer["Continue to {0}", _localizer[_pages[SelectedPageIndex+1]]]</MudText>
                </MudButton>
            }
            else
            {
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Disabled="@(!Validated || _processing)" Color="Color.Primary" Size="Size.Large" Style="width: 100%;">
                    @if (_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">@_localizer["Please Wait"]</MudText>
                    }
                    else
                    {
                        <MudText>@_localizer["Register"]</MudText>
                    }
                </MudButton>
            }
        </MudItem>
    </MudGrid>
</EditForm>