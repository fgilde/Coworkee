@page "/catalog/brands/{Action?}/{Id?}"
@attribute [Authorize(Policy = Permissions.Brands.View)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Brands> _localizer
@using CleanArchitectureBase.Shared.Wrapper
@using CleanArchitectureBase.Application.Common.Models
@using CleanArchitectureBase.Application.Contracts.Enums


<ReactOnPreferenceChanged Component="this" />
<PageHeaderTitle Title="@_localizer["Brands"]" Description="@_localizer["Manage Brands."]" />

<EditableDataTable 
    TIdType="string"
    TResult="BrandDto"
    ApiLoad="@(Load)"
    ApiDelete="@(new Func<string[], Task<Result>>(DeleteBrands))"
    ApiCreateOrEdit="@(new Func<BrandDto, Task<bool>>(CreateOrEditBrand))"
    Export="@(new Func<ExportServiceType, string, Task>(Export))"
    ExportSelected="@(new Func<ExportServiceType, string[], Task>(ExportSelected))"
    GetById="@(new Func<string, IEnumerable<BrandDto>, Task<BrandDto>>(FindById))"
    GetId="@(new Func<BrandDto,string>(GetId))"
    Display="@(new Func<BrandDto, string>(GetName))"
    TableProperties="@(new []{"Id", "Name", "Description", "Tax"})"
    InitialAction="@Action"
    InitialIdString="@Id"
    CreatePermission="@Permissions.Brands.Create"
    DeletePermission="@Permissions.Brands.Delete"
    EditPermission="@Permissions.Brands.Edit"
    ExportPermission="@Permissions.Brands.Export"
    SearchPermission="@Permissions.Brands.Search">
</EditableDataTable>