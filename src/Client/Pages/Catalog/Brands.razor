@page "/catalog/brands/{Action?}/{Id?}"
@attribute [Authorize(Policy = Permissions.Brands.View)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Brands> _localizer
@using CleanArchitectureBase.Application.Features.Brands.Queries.GetAll
@using CleanArchitectureBase.Shared.Wrapper

<style>
    .mud-table-container {
        overflow: auto;
    }
</style>

<ReactOnPreferenceChanged Component="this" />
<HeroTitle Title="@_localizer["Brands"]" Description="@_localizer["Manage Brands."]" />

<EditableDataTable ApiLoad="@(new Func<Task<Result<List<GetAllBrandsResponse>>>>(Load))"
                   ApiDelete="@(new Func<int[], Task<Result>>(DeleteBrands))"
                   ApiCreateOrEdit="@(new Func<GetAllBrandsResponse, Task<bool>>(CreateOrEditBrand))"
                   Export="@(new Func<string, Task<Result<string>>>(Export))"
                   ExportSelected="@(new Func<int[], Task<Result<string>>>(ExportSelected))"
                   GetById="@(new Func<int, IEnumerable<GetAllBrandsResponse>, Task<GetAllBrandsResponse>>(FindById))"
                   GetId="@(new Func<GetAllBrandsResponse,int>(GetId))"
                   Display="@(new Func<GetAllBrandsResponse, string>(GetName))"
                   TableProperties="@(new []{"Id", "Name", "Description", "Tax"})"
                   InitialAction="@Action"
                   InitialIdString="@Id"
                   CreatePermission="@Permissions.Brands.Create"
                   DeletePermission="@Permissions.Brands.Delete"
                   EditPermission="@Permissions.Brands.Edit"
                   ExportPermission="@Permissions.Brands.Export"
                   SearchPermission="@Permissions.Brands.Search">
</EditableDataTable>