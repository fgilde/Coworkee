@page "/catalog/products/{Action?}/{Id?}"
@attribute [Authorize(Policy = Permissions.Products.View)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Products> _localizer
@using CleanArchitectureBase.Application.Features.Products.Queries.GetAllPaged;
@using CleanArchitectureBase.Shared.Wrapper

<style>
    .mud-table-container {
        overflow: auto;
    }
</style>

<HeroTitle Title="@_localizer["Products"]" Description="@_localizer["Manage Products."]" />

<EditableDataTable
    ApiLoadPaged="@(new Func<int, int, string, string[], Task<PaginatedResult<GetAllPagedProductsResponse>>>(Load))"
    ApiDelete="@(new Func<int[], Task<Result>>(DeleteProducts))"
    ApiCreateOrEdit="@(new Func<GetAllPagedProductsResponse, Task<bool>>(CreateOrEditProduct))"
    Export="@(new Func<string, Task<Result<string>>>(Export))"
    ExportSelected="@(new Func<int[], Task<Result<string>>>(ExportSelected))"
    GetById="@(new Func<int, IEnumerable<GetAllPagedProductsResponse>, Task<GetAllPagedProductsResponse>>(FindById))"
    GetId="@(new Func<GetAllPagedProductsResponse,int>(GetId))"
    Display="@(new Func<GetAllPagedProductsResponse, string>(GetName))"
    TableProperties="@(new []{"Id", "Name", "Brand", "Description", "Barcode", "Rate"})"
    InitialAction="@Action"
    InitialIdString="@Id"
    CreatePermission="@Permissions.Products.Create"
    DeletePermission="@Permissions.Products.Delete"
    EditPermission="@Permissions.Products.Edit"
    ExportPermission="@Permissions.Products.Export"
    SearchPermission="@Permissions.Products.Search"
>
</EditableDataTable>
