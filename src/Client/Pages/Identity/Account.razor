@page "/account"
@using CleanArchitectureBase.Shared.Constants.Application
@inject Microsoft.Extensions.Localization.IStringLocalizer<Account> localizer

<ReactOnPreferenceChanged Component="this" />
<HeroTitle Title="@localizer["Account"]" Description="@localizer["Manage your account"]" />
<MudTabs Elevation="25" Color="Color.Transparent" Rounded="true" PanelClass="mt-6">
    <MudTabPanel Text="@localizer["Profile"]">
        <Profile />
    </MudTabPanel>
    <MudTabPanel Text="@localizer["Security"]">
        <Security />
    </MudTabPanel>
</MudTabs>

@code
{
    protected override async Task OnInitializedAsync()
    {
        if((await _stateProvider.GetAuthenticationStateAsync()).IsGuest())
        {
            _navigationManager.NavigateTo($"{ApplicationConstants.Routes.Forbidden}/{Uri.EscapeDataString(_navigationManager.ToBaseRelativePath(_navigationManager.Uri))}");
        }
    }
}
