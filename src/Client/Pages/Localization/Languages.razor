@page "/localization/languages"
@attribute [Authorize(Policy = Permissions.Translations.Edit)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Languages> _localizer
@using Coworkee.Shared.Constants.Localization
@using Nextended.Core.Extensions
@using Coworkee.Application.Common.Models
@using Coworkee.Application.Features.Translations.Commands.AddEdit
@using Coworkee.Application.Hubs.Events
@using Microsoft.AspNetCore.SignalR.Client
@using Coworkee.Application.Common.Extensions

<style>
    .lang-active .mud-expand-panel-header {
        color: var(--mud-palette-secondary);
    }
    .culture-code {
        font-size: x-small;
        font-weight: bold;
        margin-left: 10px;
    }
</style>

<ReactOnPreferenceChanged Component="this" />
<PageHeaderTitle Title="@_localizer["Languages"]" Description="@_localizer["Manage Languages"]" />


<MudExpansionPanels>
    @foreach (var lang in availableLanguages.GroupBy(l => l.CultureCode.Split("-")[0]))
    {
        var neutralLangLabel = (_localizer[lang.FirstOrDefault(c => c.CultureCode.Contains("-"))?.CultureCode ?? lang.Key]).Value.Split("(")[0];
        var isAnyUsed = usedLanguages.Any(c => lang.Any(l => c.CultureCode == l.CultureCode && c.DisplayName == l.DisplayName));
        var isAnyUpdating = updating.Any(c => lang.Any(l => c.CultureCode == l.CultureCode && c.DisplayName == l.DisplayName));

        <MudExpansionPanel Class="@(isAnyUsed ? "lang-active" : "")" Text="@neutralLangLabel">
            <TitleContent>
                <div class="d-flex">
                    <MudText>@neutralLangLabel</MudText>
                    @if (isAnyUpdating)
                    {
                        <MudSpacer />
                        <MudProgressCircular Color="Color.Primary" Class="mr-4 ml-4" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="mr-5" Typo="Typo.subtitle2">@_localizer["Translations are being imported"]</MudText>
                    }
                </div>
            </TitleContent>
            <ChildContent>
                <MudGrid>
                    @foreach (var l in lang)
                    {
                        <MudItem xs="6" md="3">
                            <MudSwitch CheckedChanged="@(new Action<bool>(e => Activate(l, e)))" Checked="@l.IsActive" Label="@(l.CultureCode.Contains('-') ? _localizer[l.CultureCode] : neutralLangLabel)" Color="Color.Warning"/>
                            <span class="culture-code">@l.CultureCode</span>
                        </MudItem>
                    }
                </MudGrid>
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code
{
    [CascadingParameter] private HubConnection HubConnection { get; set; }
    IList<LanguageDto> usedLanguages;
    IList<LanguageDto> availableLanguages;
    readonly IList<LanguageDto> updating = new List<LanguageDto>();

    protected override async Task OnInitializedAsync()
    {
        await Load();
        var currentUser = await _clientAuthenticationManager.CurrentUser();

        HubConnection = await HubConnection.EnsureStartedAsync(_config.BackendOrigin);
        HubConnection.On<EntitiesUpdated<LanguageDto>>(async (a) =>
        {
            if (a.User.Id != currentUser.GetUserId())
                await Load();
        });
    }

    private async Task Load()
    {
        var server = await _api.Language_GetAllAsync();
        usedLanguages = server.Where(l => l.IsActive).ToList();
        if (usedLanguages == null || !usedLanguages.Any())
        {
            usedLanguages = LocalizationConstants.DefaultUILanguages.MapElementsTo<LanguageDto>().ToList();
            var res = await _api.Language_PostAsync(new AddEditLanguagesCommand(usedLanguages.Select(l => Prepare(l, true)).ToArray()) {AutoCreateTranslations = false});
            usedLanguages = res.Added;
            server.AddRange(usedLanguages);
        }

        var local = LocalizationConstants.SystemCultures.MapElementsTo<LanguageDto>().Apply(l =>
            l.IsActive = usedLanguages.Any(c => c.CultureCode == l.CultureCode && c.DisplayName == l.DisplayName));
        availableLanguages = server.Concat(local).DistinctBy(dto => dto.CultureCode).ToList();
    }

    private LanguageDto Prepare(LanguageDto language, bool active)
    {
        language.IsActive = active;
        language.DisplayName = _localizer[language.CultureCode];
        return language;
    }

    private async void Activate(LanguageDto language, bool active)
    {
        var autoCreateTranslations = active && LocalizationConstants.ExistingTranslations.All(l => l.CultureCode != language.CultureCode);
        if (autoCreateTranslations) 
            updating.Add(language);

        await _api.Language_PostAsync(new AddEditLanguagesCommand(Prepare(language, active)) {AutoCreateTranslations = autoCreateTranslations});
        language.IsActive = active;
        usedLanguages = availableLanguages.Where(dto => dto.IsActive).ToList();

        if (autoCreateTranslations) 
            updating.Remove(language);

        StateHasChanged();
    }
}