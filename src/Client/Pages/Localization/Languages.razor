@page "/localization/languages"
@attribute [Authorize(Policy = Permissions.Products.View)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Languages> _localizer
@using CleanArchitectureBase.Shared.Constants.Localization

<style>
    .lang-active .mud-expand-panel-header {
        color: var(--mud-palette-secondary);
    }
    .culture-code {
        font-size: x-small;
        font-weight: bold;
        margin-left: 10px;
    }
</style>

<ReactOnPreferenceChanged Component="this" />
<HeroTitle Title="@_localizer["Languages"]" Description="@_localizer["Manage Languages"]" />


@{
    var languageCodes = LocalizationConstants.AvailableLanguages;
    var usedLanguages = LocalizationConstants.SupportedLanguages;
}

<MudExpansionPanels>
    @foreach (var lang in languageCodes.GroupBy(l => l.Code.Split("-")[0]))
    {
        var neutralLangLabel = (_localizer[lang.FirstOrDefault(c => c.Code.Contains("-"))?.Code ?? lang.Key]).Value.Split("(")[0];
        var isAnyUsed = usedLanguages.Any(c => lang.Any(l => c.Code == l.Code && c.DisplayName == l.DisplayName));

        <MudExpansionPanel Class="@(isAnyUsed ? "lang-active" : "")" Text="@neutralLangLabel">
            <MudList>
                @foreach (var l in lang)
                {
                    var isUsed = usedLanguages.Any(c => c.Code == l.Code && c.DisplayName == l.DisplayName);
                    <MudListItem>
                        <MudSwitch Checked="@isUsed" Label="@(l.Code.Contains('-') ? _localizer[l.Code] : neutralLangLabel)" Color="Color.Warning"/>
                        <span class="culture-code">@l.Code</span>
                    </MudListItem>
                }
            </MudList>
        </MudExpansionPanel>
    }
</MudExpansionPanels>




