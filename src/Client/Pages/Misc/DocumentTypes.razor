@page "/document-types/{Action?}/{Id?}"
@attribute [Authorize(Policy = Permissions.Brands.View)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<DocumentTypes> _localizer
@using Coworkee.Shared.Wrapper
@using Coworkee.Application.Common.Models
@using Coworkee.Application.Contracts.Enums


<ReactOnPreferenceChanged Component="this" />
<PageHeaderTitle Title="@_localizer["Document Types"]" Description="@_localizer["Manage Document Types."]" />

<EditableDataTable ApiLoad="@(Load)"
                   ApiDelete="@(new Func<int[], Task<Result>>(Delete))"
                   ApiCreateOrEdit="@(new Func<DocumentTypeDto, Task<bool>>(CreateOrEdit))"
                   Export="@(new Func<ExportServiceType, string, Task>(Export))"
                   ExportSelected="@(new Func<ExportServiceType, int[], Task>(ExportSelected))"
                   GetById="@(new Func<int, IEnumerable<DocumentTypeDto>, Task<DocumentTypeDto>>(FindById))"
                   GetId="@(new Func<DocumentTypeDto,int>(GetId))"
                   Display="@(new Func<DocumentTypeDto, string>(GetName))"
                   TableProperties="@(new []{"Id", "Name", "Description"})"
                   InitialAction="@Action"
                   InitialIdString="@Id"
                   CreatePermission="@Permissions.DocumentTypes.Create"
                   DeletePermission="@Permissions.DocumentTypes.Delete"
                   EditPermission="@Permissions.DocumentTypes.Edit"
                   ExportPermission="@Permissions.DocumentTypes.Export"
                   SearchPermission="@Permissions.DocumentTypes.Search">
</EditableDataTable>