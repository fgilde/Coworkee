@using CleanArchitectureBase.Shared.Constants

@if (MenuTogglePosition == MenuTogglePosition.Start)
{
    <MudToolBar DisableGutters="true">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" OnClick="@(e => OnMenuIconClick.InvokeAsync(e))" Class="ml-3" />
    </MudToolBar>
}

<MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
    @if (IsLogoVisible)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
            <p class="cursor-pointer" @onclick="MainClick">
                <ApplicationLogo Height="35" Width="35" />
            </p>
        </MudHidden>
    }

    @if (!string.IsNullOrEmpty(Title) && TitleBehaviour != AppBarTitleBehaviour.Hidden)
    {
        <p class="cursor-pointer" @onclick="MainClick">
            <MudText Typo="Typo.h6" Class="ml-4">@GetRenderTitle()</MudText>
        </p>
    }
</MudHidden>

@if (MenuTogglePosition == MenuTogglePosition.End)
{
    <MudToolBar DisableGutters="true">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" OnClick="@(e => OnMenuIconClick.InvokeAsync(e))" Class="ml-3" />
    </MudToolBar>
}
