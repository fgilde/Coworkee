@using Coworkee.Shared.Constants
@using MudBlazor.Extensions.Core
@using MudBlazor.Extensions.Helper

@namespace Coworkee.Client.Shared.Components

<MudIcon Class="@Class" Icon="@Icon" Size="@Size" @attributes="attributes" Style="@StyleStr()" />

@code
{
    private bool _iconPrepared;
    private Dictionary<string, object> attributes;

    [Parameter]
    public int Height { get; set; } = 100;

    [Parameter]
    public int Width { get; set; } = 100;

    [Parameter]
    public string ViewBox { get; set; } = "0 0 500 500";

    [Parameter]
    public Size Size { get; set; } = Size.Large;

    [Parameter]
    public MudExColor StrokeColor { get; set; } = Color.Inherit;

    [Parameter]
    public MudExColor FillColor { get; set; } = Color.Inherit;

    [Parameter]
    public string Style { get; set; } = "";

    [Parameter]
    public string Class { get; set; } = "";

    [Parameter]
    public string Icon { get; set; } = CustomIcons.ApplicationMainIcon;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        attributes = new Dictionary<string, object>
            {
                ["ViewBox"] = !string.IsNullOrEmpty(ViewBox) ? ViewBox : $"0 0 {Width} {Height}"
            };
    }

    private string StyleStr()
    {
        var fillColorUsed = !FillColor.Is(Color.Inherit) && !FillColor.Is(Color.Default);
        if (fillColorUsed && !_iconPrepared)
        {
            Icon = MudExSvg.RemoveFillColors(CustomIcons.ApplicationMainIcon);
            _iconPrepared = true;
        }

        return MudExStyleBuilder.Default
            .AddRaw(Style)
            .WithFill(FillColor, fillColorUsed)
            .WithStroke(StrokeColor, !StrokeColor.Is(Color.Inherit) && !StrokeColor.Is(Color.Default))
            .WithSize(Width, Height)
            .Build();
    }
}