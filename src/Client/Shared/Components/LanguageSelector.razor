@using Coworkee.Shared.Constants.Localization
@using Coworkee.Shared.Settings
@using Nextended.Core.Extensions
@using Coworkee.Application.Common.Models
@using Coworkee.Application.Hubs.Events
@using Microsoft.AspNetCore.SignalR.Client
@using System.Security.Claims
@using Coworkee.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<LanguageSelector> localizer
@implements IAsyncDisposable

@{
    if (languages?.Count > 1)
    {
        displayName = actuaLanguage != null ? DisplayStr(actuaLanguage) : localizer["Select Language"];
        <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" MaxHeight="350" Label="@(Small ? "" : displayName)" Icon="@(Small ? Icons.Material.Outlined.Language : null)" EndIcon="@(Small ? null : Icons.Material.Outlined.KeyboardArrowDown)" Color="Color.Inherit" Direction="Direction.Right" OffsetY="true" Dense="true">
            @{
                foreach (var language in languages)
                {
                    <MudMenuItem Disabled="language.CultureCode == preference?.LanguageCode" OnClick="(() => ChangeLanguageAsync(language))">
                        <MudText Typo="Typo.body2">
                            @if (language.CultureCode == preference?.LanguageCode)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Class="mr-3 mb-n1"/>
                            }
                            @DisplayStr(language)
                            <span class="culture-code">@language.CultureCode</span>
                        </MudText>
                    </MudMenuItem>
                }
            }

        </MudMenu>
    }
}

@code
{
    [Parameter] public bool Small { get; set; } = false;
    [CascadingParameter] private HubConnection HubConnection { get; set; }
    [CascadingParameter] internal ClaimsPrincipal User { get; set; }
    string displayName;
    IList<LanguageDto> languages;
    LanguageDto actuaLanguage;

    IPreference preference;
    protected override async Task OnInitializedAsync()
    {
        await Load();
        HubConnection = await HubConnection.EnsureStartedAsync(_config.BackendOrigin);
        HubConnection.On<EntitiesUpdated<LanguageDto>>(async (a) =>
        {
            await Load();
            StateHasChanged();
        });
    }

    private async Task<LanguageDto> GetEnsuredActualLanguage()
    {
        var result = languages?.FirstOrDefault(l => l.CultureCode == preference?.LanguageCode) ?? languages?.FirstOrDefault();
        if (result != null && result.CultureCode != preference?.LanguageCode)
            await ChangeLanguageAsync(result);
        return result;
    }

    private async Task Load()
    {
        await LoadPreferenceAsync();
        languages = await _api.Language_GetAllAsync(new TransferableExpression<LanguageDto>(l => l.IsActive));
        if (languages == null || !languages.Any())
            languages = LocalizationConstants.DefaultUILanguages.MapElementsTo<LanguageDto>().ToList();
        actuaLanguage = await GetEnsuredActualLanguage();
    }

    private string DisplayStr(LanguageDto language)
    {
        string display = localizer[language.CultureCode];
        if (display == language.CultureCode)
            display = language.DisplayName;
        return display;
    }

    private async Task LoadPreferenceAsync()
    {
        preference = await _clientPreferenceManager.GetPreference();
    }

    private async Task ChangeLanguageAsync(LanguageDto languageCode)
    {
        var result = await _clientPreferenceManager.ChangeLanguageAsync(languageCode.CultureCode);
        if (languageCode.IsRTL.HasValue && ((ClientPreference)preference).IsRTL != languageCode.IsRTL.Value)
        {
            await _clientPreferenceManager.ToggleLayoutDirection();
        }
        
        if (_errorService.IsSuccessFull(result))
        {
            actuaLanguage = languageCode;
            _snackBar.Add(result.Messages[0], Severity.Success);
            await LoadPreferenceAsync();
            StateHasChanged();
            _navigationManager.Reload();
            if (User?.Identity?.IsAuthenticated == true)
            {
                await _api.Account_SetPreferredLanguageAsync(languageCode);
            }
        }
    }

    public ValueTask DisposeAsync()
    {
        return HubConnection.TryDisposeAsync();
    }
}
