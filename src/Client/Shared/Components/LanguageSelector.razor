@using CleanArchitectureBase.Shared.Constants.Localization
@using CleanArchitectureBase.Shared.Settings
@inject Microsoft.Extensions.Localization.IStringLocalizer<LanguageSelector> localizer

@{
    string actual = preference?.LanguageCode;
    var actualLanguge = LocalizationConstants.SupportedLanguages.FirstOrDefault(l => l.Code == actual);
    string displayName = actualLanguge!= null ? DisplayStr(actualLanguge) : localizer["Select Language"];

    <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" MaxHeight="350" Label="@(Small ? "" : displayName)" Icon="@(Small ? Icons.Material.Outlined.Language : null)" EndIcon="@(Small ? null : Icons.Material.Outlined.KeyboardArrowDown)" Color="Color.Inherit" Direction="Direction.Right" OffsetY="true" Dense="true">
        @{
            foreach (var language in LocalizationConstants.SupportedLanguages)
            {
                <MudMenuItem Disabled="language.Code == actual" OnClick="(() => ChangeLanguageAsync(language))">
                    <MudText Typo="Typo.body2">
                        @if (language.Code == actual)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Class="mr-3 mb-n1" />
                        }
                        @DisplayStr(language)
                        <span class="culture-code">@language.Code</span>
                    </MudText>
                </MudMenuItem>
            }
        }

    </MudMenu>
}

@code
{
    [Parameter]
    public bool Small { get; set; } = false;

    IPreference preference;
    protected override async Task OnInitializedAsync()
    {
        await LoadPreferenceAsync();
    }

    private string DisplayStr(LanguageCode language)
    {
        string display = localizer[language.Code];
        if (display == language.Code)
            display = language.DisplayName;
        return display;
    }

    private async Task LoadPreferenceAsync()
    {
        preference = await _clientPreferenceManager.GetPreference();
    }

    private async Task ChangeLanguageAsync(LanguageCode languageCode)
    {
        var result = await _clientPreferenceManager.ChangeLanguageAsync(languageCode.Code);
        if (languageCode.IsRTL.HasValue && ((ClientPreference)preference).IsRTL != languageCode.IsRTL.Value)
        {
            await _clientPreferenceManager.ToggleLayoutDirection();
        }
        if (result.Succeeded)
        {
            _snackBar.Add(result.Messages[0], Severity.Success);
            await LoadPreferenceAsync();
            StateHasChanged();
            _navigationManager.Reload();
    //_navigationManager.NavigateTo(_navigationManager.Uri, forceLoad: true);
        }
        else
        {
            foreach (var error in result.Messages)
            {
                _snackBar.Add(error, Severity.Error);
            }
        }
    }
}
