@using CleanArchitectureBase.Application.Common.Models
@using CleanArchitectureBase.Application.Contracts.Enums
@using Nextended.Core.Extensions

<div style="display: flex; height: 100%">
<MudContainer MaxWidth="MaxWidth.ExtraSmall" Style="min-width:527px; padding:0; margin:0;">
    <EditableDataTable @ref="@table"
                        ChangeUrl="false"
                       AllowRowSelection="true"
                       @bind-SelectedItem="@_selectedNotification"
                           TIdType="string"
                           TResult="NotificationDto"
                           UseMudExPropertyEditAsView="false"
                           ApiLoadPaged="@(Load)"
                           ApiDelete="@(Delete)"
                           GetById="@(FindById)"
                           GetId="@(GetId)"
                        Display="@(GetName)"
                           RowStyle="@(GetRowStyle)"
                           TableProperties="@(new[] {nameof(NotificationDto.Subject)})"
                           InitialAction="@Action"
                           InitialIdString="@Id">
        </EditableDataTable>
</MudContainer>
<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    @if (_selectedNotification?.SetProperties(p => p.Expanded = true) != null)
        {
            <NotificationView AutoMarkAsRead="false" OnRead="@OnMarkRead" OnDelete="@OnDelete" ShowNavigateTo="false" RenderToolsOnTop="true" Notification="@_selectedNotification"></NotificationView>
        }
</MudContainer>
</div>