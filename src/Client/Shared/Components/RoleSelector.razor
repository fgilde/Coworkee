@using CleanArchitectureBase.Application.Responses.Identity
@using CleanArchitectureBase.Client.Infrastructure.Extensions
@using Nextended.Core.Extensions
@inject Microsoft.Extensions.Localization.IStringLocalizer<RoleSelector> localizer

@{
    @if (IsVisible)
    {
        <MudTooltip Placement="Placement.Start" Text="@DisplayName(false)">
            <MudMenu MaxHeight="350" Class="role-selector-menu" Label="@DisplayName()" EndIcon="@Icons.Material.Outlined.KeyboardArrowDown" Color="Color.Inherit" FullWidth="true" Direction="Direction.Right" OffsetY="true" Dense="true">
                <MudText Typo="Typo.body2" Class="px-4 py-2"><b>@localizer["Select active Roles"]</b></MudText>
                <MudMenuItem Class="px-4 py-2" OnClick="() => AddUpdateRole(null)">
                    @DisplayName(true, true)
                </MudMenuItem>
                <MudDivider Vertical="false" DividerType="DividerType.FullWidth" />
                @foreach (var role in userRoles)
                {
                    <MudMenuItem OnClick ="() => ToggleRole(role)"> @*Direct click work s toggle otherwise in checkbox is multi select*@
                        <MudCheckBox Label="@localizer[role.RoleName]" CheckedChanged="@(new Action<bool>(e => AddUpdateRole(role, e)))" Checked="@IsSelected(role.Id)"></MudCheckBox>
                    </MudMenuItem>
                }
            </MudMenu>
        </MudTooltip>
    }
}

@code
{
    public bool IsVisible { get; private set; }
    List<UserRoleModel> actualRoles;
    List<UserRoleModel> userRoles;

    private string DisplayName(bool ellipse = true, bool forceAll = false)
    {
        var res = !forceAll && actualRoles != null && actualRoles.Any() ? string.Join(", ", actualRoles.Select(m => m.RoleName)) : $"< {localizer["All Roles"]} >";
        return ellipse ? res.ToEllipsis(20): res;
    }

    private bool IsSelected(string roleId)
    {
        return actualRoles != null && actualRoles.Any(m => m.Id == roleId);
    }

    protected override async Task OnInitializedAsync()
    {
        await UpdateDataAsync();
    }

    private async Task UpdateDataAsync()
    {
        var roleResult = await _api.User_GetMyRolesAsync();
        userRoles = roleResult.Data.UserRoles;
        IsVisible = roleResult.Succeeded && userRoles.Count > 1; // At least one role
    }

    private void ToggleRole(UserRoleModel role)
    {
        var add = actualRoles?.Contains(role) ?? false;
        actualRoles = null;
        AddUpdateRole(role, add);
    }

    private void AddUpdateRole(UserRoleModel role, bool add = true)
    {
        actualRoles = role == null ? null : actualRoles ?? new List<UserRoleModel>();
        if (add && role != null)
            actualRoles?.Add(role);
        else if (role != null && actualRoles?.Contains(role) == true)
            actualRoles.Remove(role);

        if (add && role != null && userRoles != null && userRoles.All(m => actualRoles?.Contains(m) == true)) // Every role is selected then all roles should be used
            actualRoles = null;

        _httpClient.SetActiveRoleId(actualRoles?.Select(m => m.Id)?.ToArray());
    }
}