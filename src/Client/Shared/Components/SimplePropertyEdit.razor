@if (ReadOnly)
{
    <p>@StringValue</p>
}
else
{

    @if (Property.PropertyType == typeof(int))
    {
        //For = "@(() => AddEditBrandModel.Id)"
        <MudNumericField @bind-Value="IntValue" Required Min="1"/>
    }
    else
    {
        <MudTextField @bind-Value="StringValue" Required/>
    }
}

