@using Nextended.Core.Extensions
@using Coworkee.Client.Theming
@using Coworkee.Client.Managers.Theme
@using MudBlazor.Extensions.Core
@inject Microsoft.Extensions.Localization.IStringLocalizer<ThemeSelector> localizer


<MudDrawer @bind-Open="@_charmOpen" Anchor="@(_rtl ? Anchor.Left: Anchor.Right)" Elevation="1" Variant="@DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudIcon Class="mt-1 mr-3" Icon="@Icons.Material.Filled.Colorize"></MudIcon>
        <MudText Typo="Typo.h6">@localizer["Select Theme"]</MudText>
    </MudDrawerHeader>
    <MudNavMenu>
        <MudButtonGroup Variant="Variant.Outlined" Style="width: 100%; justify-content: center;" Color="Color.Default">
            <MudToggleIconButton Toggled="@IsDark" ToggledChanged="@(OnDarkChange)" Title="@localizer["Dark Mode"]" ToggledTitle="@localizer["Light Mode"]" Icon="@Icons.Material.Outlined.LightMode" ToggledIcon="@Icons.Material.Filled.DarkMode" Color="Color.Info" ToggledColor="Color.Warning">
            </MudToggleIconButton>
            <MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="@EditTheme">@localizer["Customize"]</MudButton>
        </MudButtonGroup>
        
        <MudContainer Class="mt-10" Style="padding:0;">
            
            <MudExThemeSelect TTheme="ClientTheme"
                              PreviewMode="@(IsDark ? ThemePreviewMode.DarkOnly : ThemePreviewMode.LightOnly)"
                              Style="margin: 5px"
                              SelectionMode="ThemeSelectionMode.ItemList"
                              PreviewImageSize="@(new MudExDimension(110, 90))"
                              Available="@_themes"
                              @bind-Selected="@Selected">
            </MudExThemeSelect>
        </MudContainer>

    </MudNavMenu>

</MudDrawer>

@if (_themes is { Count: > 1 })
{
    <MudIconButton Icon="@Icon" Color="Color.Inherit" OnClick="@ButtonClicked"/>
}
