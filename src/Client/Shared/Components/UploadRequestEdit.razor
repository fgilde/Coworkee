@using CleanArchitectureBase.Application.Requests
@inject Microsoft.Extensions.Localization.IStringLocalizer<UploadRequestEdit> _localizer

@if (!string.IsNullOrWhiteSpace(_errorMessage) && DisplayErrors)
{
    <p class="error-message">@_errorMessage</p>
}

<div @ref="dropZoneElement" style="@StyleStr()" class="upload-request-edit @(AllowDrop ? "drop-zone" : "") @Class">

    <MudGrid Spacing="1">
        @if (AllowMultiple)
        {
            <InputFile @ref="inputFile" id="@(UploadFieldId)" hidden multiple OnChange="UploadFiles" accept="@($"{_accept},{_acceptExtensions}")" />
        }
        else
        {
            <InputFile @ref="inputFile" id="@(UploadFieldId)" hidden OnChange="UploadFiles" accept="@($"{_accept},{_acceptExtensions}")" />
        }

        @foreach (var request in UploadRequests ?? Enumerable.Empty<UploadRequest>())
        {
            <MudItem xs="12">
                <MudItem>
                    <MudAlert Icon="@GetIcon(request)"
                          Class="mud-alert-message-w-100"
                          Severity="@(IsSelected(request) ? Severity.Warning : (_withErrors.Contains(request) ? Severity.Error : Severity.Normal))"
                          OnClick="(a) => Select(request, a)"
                          ShowCloseIcon="@AllowRemovingItems"
                          CloseIcon="@Icons.Filled.Delete"
                          CloseIconClicked="(() => Remove(request))">
                        @request.FileName
                        @if (AllowPreview)
                        {
                            <MudIconButton OnClick="@(() => Preview(request))" Style="float: right;" Icon="@Icons.Material.Filled.ZoomIn" Color="Color.Inherit" Size="Size.Small" />
                        }
                    </MudAlert>
                </MudItem>
            </MudItem>
        }
    </MudGrid>
</div>

<div class="multi-upload-actions">
    @if (ShowFileUploadButton)
        {

            <MudButton HtmlTag="label"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@(AllowMultiple ? Icons.Filled.FileUpload : Icons.Filled.UploadFile)"
                       for="@UploadFieldId">
                @(AllowMultiple ? _localizer["Upload Files"] : _localizer["Upload File"])
            </MudButton>

        }

        @if (AllowFolderUpload && AllowMultiple && ShowFolderUploadButton)
        {
            <span class="action-margin"></span>
            <MudButton HtmlTag="label"
                       OnClick="@(UploadFolder)"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Filled.DriveFolderUpload">
                @_localizer["Upload Folder"]
            </MudButton>
        }
        
        @if (ShowClearButton && UploadRequests?.Any() == true)
        {
            <MudIconButton Title="@_localizer["Remove All"]" OnClick="@RemoveAll" Style="float: right; margin-right: 15px;" Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Primary" Size="Size.Small" />
        }
</div>