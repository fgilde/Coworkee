@using CleanArchitectureBase.Client.Shared.Components

<MudCard Class="@($"transparent {Class}")" Elevation="0" Square="true">
    <MudCardHeader Class="@($"transparent {Class}")" Style="@Style">
        <CardHeaderAvatar>
            <UserAvatar IsUserOnline="@IsUserOnline" UserId="@UserId" User="@User" UserData="@UserData" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.body2">@FirstName @SecondName</MudText>

            @if (ShowLogout)
            {
            <div style="position: absolute; right: 0px; top: 25px;">
                <MudButton OnClick="Logout" StartIcon="@Icons.Outlined.Login" Color="Color.Transparent" />
            </div>
            }

            @if (ShowEmail)
            {
            <MudText Typo="Typo.caption">@Email</MudText>
            }
        </CardHeaderContent>
    </MudCardHeader>
</MudCard>