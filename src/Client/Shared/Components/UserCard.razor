@namespace CleanArchitectureBase.Client.Shared.Components
<MudCard Elevation="0" Square="true" Class="@Class">
    <MudCardHeader>
        <CardHeaderAvatar>
            <UserAvatar User="User" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.body2">@FirstName @SecondName</MudText>
            @if (ShowEmail)
            {
                <MudText Typo="Typo.caption">@Email</MudText>
            }
        </CardHeaderContent>
    </MudCardHeader>
</MudCard>