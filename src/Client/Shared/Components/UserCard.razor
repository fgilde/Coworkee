@namespace CleanArchitectureBase.Client.Shared.Components
<MudCard Elevation="0" Square="true" Class="@Class">
    <MudCardHeader>
        <CardHeaderAvatar>
            <UserAvatar User="User" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.body2">@FirstName @SecondName</MudText>

            @if (ShowLogout)
            {
                <div style="position: absolute; right: 2px; top: 30px;">
                    <MudButton OnClick="Logout" StartIcon="@Icons.Outlined.Login" Color="Color.Transparent" />
                </div>
            }

            @if (ShowEmail)
            {
                <MudText Typo="Typo.caption">@Email</MudText>
            }
        </CardHeaderContent>
    </MudCardHeader>
</MudCard>