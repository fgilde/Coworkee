@using Nextended.Core.Extensions
@using CleanArchitectureBase.Application.Common.Models.Identity
@using System.Threading
@using Microsoft.AspNetCore.Components.Rendering
@inject Microsoft.Extensions.Localization.IStringLocalizer<UserFilter> _localizer

@inherits MudExChipSelect<UserResponse>

@Inherited()

@code {
    public override Color ChipColor { get; set; } = Color.Secondary;
    public override Variant ChipVariant { get; set; } = Variant.Outlined;
    public override string Label { get; set; } = "User";
    public override string HelperText { get; set; } = "Search by users";
    public override bool UseCustomItemRenderInSelectionPopover { get; set; } = true;
    protected RenderFragment Inherited() => builder => base.BuildRenderTree(builder);
    
    protected override async Task<IList<UserResponse>> GetAvailableItemsAsync(CancellationToken cancellation = default)
        => (await _api.User_GetAllAsync(cancellationToken: cancellation)).Data;

    public override string ItemNameRender(UserResponse item) => item?.FullName;

    protected override RenderFragment RenderItem(RenderTreeBuilder __builder, UserResponse item)
        => @<UserCard UserData="@item" ShowLogout="false"></UserCard>;
}