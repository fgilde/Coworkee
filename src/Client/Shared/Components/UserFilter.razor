@using Nextended.Core.Extensions
@using Coworkee.Application.Common.Models.Identity
@using System.Threading
@using Microsoft.AspNetCore.Components.Rendering
@using MudBlazor.Extensions.Options
@inject Microsoft.Extensions.Localization.IStringLocalizer<UserFilter> _localizer

@inherits MudExSelect<UserResponse>

@Inherited()

@code {    
    public override Variant ChipVariant { get; set; } = Variant.Outlined;
    public override Func<UserResponse, string> ToStringFunc { get; set; } = ItemNameRender;
    protected RenderFragment Inherited() => builder => base.BuildRenderTree(builder);

    protected override async Task<IList<UserResponse>> GetAvailableItemsAsync(CancellationToken cancellation = default)
        => (await _api.User_GetAllAsync(cancellationToken: cancellation)).Data;

    public static string ItemNameRender(UserResponse item) => item?.FullName;

    protected override void OnInitialized()
    {
        Color = Color.Secondary;
        Label = _localizer["User"];
        HelperText = _localizer["Search by users"];
        ItemTemplate = GetItemTemplate();
        ValuePresenter = ValuePresenter.Chip;
        MultiSelection = true;
        ChipSize = Size.Large;
        base.OnInitialized();        
    }
    
    private RenderFragment<UserResponse> GetItemTemplate() => context =>
        @<UserCard UserData="@context" ShowLogout="false"></UserCard>;
    
}