@namespace CleanArchitectureBase.Client.Shared.Dialogs
@inject Microsoft.Extensions.Localization.IStringLocalizer<MessageDialog> localizer
<MudDialog Class="@Class">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Color="Color.Secondary" Icon="@Icon" Class="mr-3 mb-n1"/>
            @MudDialog.Title
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@Message</MudText>
        <MudTextField @bind-Value="@Value"></MudTextField>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@localizer[CancelText]</MudButton>
        <MudButton Disabled="@(!IsValid())" Color="Color.Error" Variant="Variant.Filled" OnClick="@(Submit)">@localizer[OkText]</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public string OkText { get; set; } = "Ok";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string Value { get; set; }
    [Parameter] public string Class { get; set; }
    [Parameter] public string Message { get; set; }
    [Parameter] public string Icon { get; set; }
    [Parameter] public IEnumerable<string> Details { get; set; }
    [Parameter] public Func<string, bool> CanConfirm { get; set; } = s => true;

    void Submit()
    {
        MudDialog.Close(DialogResult.Ok(Value));
    }

    void Cancel() => MudDialog.Cancel();

    private bool IsValid() => CanConfirm(Value);

}