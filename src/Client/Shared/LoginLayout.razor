@using CleanArchitectureBase.Client.Theming
@inherits LayoutComponentBase

<MudThemeProvider Theme="ClientTheme.DefaultTheme" />
<MudSnackbarProvider />
<MudAppBar Elevation="4" Color="Color.Primary">
    <MudSpacer />
    <LanguageSelector />
    <ThemeSelector Mode="ThemeSelector.SelectionMode.ToggleCircle" />
</MudAppBar>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 100vh;">
    <MudPaper Elevation="25" Class="pa-8" Style="width: 500px;">
        @Body
    </MudPaper>
</MudContainer>

