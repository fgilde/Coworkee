@using Coworkee.Application.Common.Extensions
@using Coworkee.Shared.Constants.Application
@inject Microsoft.Extensions.Localization.IStringLocalizer<MainAppBar> localizer

<MudAppBar Style="@Layout.CurrentTheme.StyleAppBar" Elevation="25">

    <AppBarHeader Title="@GetTitle()"
                  @ref="_appBarHeader"
                  MenuTogglePosition="Layout.CurrentTheme.MenuTogglePosition"
                  TitleBehaviour="Layout.CurrentTheme.AppBarTitleBehaviour"
                  IsLogoVisible="Layout.CurrentTheme.ShowLogoInAppBar"
                  OnMenuIconClick="(e) => Layout.DrawerToggle()"/>

    <MudSpacer/>
    <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
        @if (!(CurrentUser?.Identity?.IsAuthenticated ?? false) || CurrentUser.IsGuest())
        {
            <MudButton DisableElevation Variant="Variant.Filled" Color="Color.Secondary" Link="@ApplicationConstants.Routes.Login" StartIcon="@Icons.Material.Filled.SwitchAccount">@localizer["Sign In"]</MudButton>
            <MudButton Style="margin-left: 5px;" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.NewLabel" Color="Color.Info" Link="@ApplicationConstants.Routes.Register">@localizer["Register"]</MudButton>
        }

        @if (_config?.ServerConfiguration?.AssistantAvailable == true)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.Assistant" Size="Size.Small" Color="Color.Inherit" OnClick="OnAssistantClick"/>
        }

        <RoleSelector/>
        <MudDivider Vertical="true" FlexItem="true" DividerType="DividerType.Middle" Class="mx-4 my-5"/>
        <LanguageSelector/>

        <MudTooltip Text="@localizer["Toggle right-to-left/left-to-right"]">
            <MudIconButton Icon="@Icons.Material.Filled.FormatTextdirectionRToL" Color="Color.Inherit" OnClick="@((e) => RightToLeftToggle())"/>
        </MudTooltip>
        <ThemeSelector />
        @if (CurrentUser?.Identity?.IsAuthenticated == true && !CurrentUser.IsGuest())
        {

            <NotificationToggle/>

            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.BottomRight" Dense="true" Class="mt-1">
                <ActivatorContent>
                    <UserAvatar LinkToProfile="false"/>
                </ActivatorContent>
                <ChildContent>
                    <UserCard Class="mt-n2"/>
                    <MudDivider Class="mb-2"/>
                    <MudListItem T="object" Text="@localizer["Account"]" Href="/account" Icon="@Icons.Material.Outlined.Person" />
                    <MudListItem T="object" Text="@localizer["Logout"]" Icon="@Icons.Material.Filled.Logout" OnClick="Logout" />
                </ChildContent>
            </MudMenu>
        }
        <MudTooltip Text="@localizer["about"]">
            <MudIconButton Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Color="Color.Inherit" OnClick="ShowAbout"/>
        </MudTooltip>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
        <RoleSelector/>
        <LanguageSelector Small="true"/>
        <MudMenu Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" Dense="true" Direction="Layout.RightToLeft ? Direction.Left : Direction.Right" OffsetY="true">
            <div class="px-2">
                <ThemeSelector ToggleOnly="true"/>
                <NotificationToggle/>
                <MudTooltip Text="@localizer["Toggle right-to-left/left-to-right"]">
                    <MudIconButton Icon="@Icons.Material.Filled.FormatTextdirectionRToL" Color="Color.Inherit" OnClick="@((e) => RightToLeftToggle())"/>
                </MudTooltip>
            </div>
            <MudText Typo="Typo.body2" Class="px-4 py-2"><b>@localizer["Account"]</b></MudText>
            <MudListItem T="object" Text="@localizer["Account"]" Href="/account" Icon="@Icons.Material.Outlined.Person" />
            <MudListItem T="object" Text="@localizer["Logout"]" Icon="@Icons.Material.Filled.Logout" OnClick="Logout"/>
        </MudMenu>
    </MudHidden>
</MudAppBar>
