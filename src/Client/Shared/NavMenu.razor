@using Nextended.Core.Extensions
@using Coworkee.Application.Common.Extensions
@inject Microsoft.Extensions.Localization.IStringLocalizer<NavMenu> _localizer

<ReactOnPreferenceChanged Component="this" />
<div>
    @if (ShowApplicationLogo)
    {
        <div class="d-flex justify-center mt-4 mb-4">
            <ApplicationLogo />
        </div>
        <MudDivider Class="mb-2" />
    }

    @if (ShowUserCard && User?.Identity?.IsAuthenticated == true && !User.IsGuest())
    {
        @if (IsMini)
        {
            <div class="mini-avatar">
                <UserAvatar />
            </div>
        }
        else
        {
            <UserCard Logout="Logout" ShowEmail="false" ShowLogout="false" />
        }
        <MudDivider Class="mb-2" />
    }

    <MudNavMenu>
        <MudTreeView Items="@Entries">
            <ItemTemplate>
                @if (IsAuthorized(context))
                {
                    if (IsMini)
                    {
                        context.IsExpanded = true;
                    }
                    <MudTreeViewItem @bind-Expanded="@context.IsExpanded" Items="@context.Children">
                        <Content>
                            @if (HasAction(context))
                            {
                            @if (IsMini)
                                {
                                <MudTooltip Placement="Placement.End" Arrow="false" Inline="false" Text="@_localizer[context.Text]">
                                    <MudNavLink Class="mini-nav-link" Href="@context.Href" Match="@(context.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" Target="@context.Target" Icon="@context.Icon">
                                    </MudNavLink>
                                </MudTooltip>
                                }
                                else
                                {
                                <MudNavLink Href="@context.Href" Match="@(context.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" Target="@context.Target" Icon="@context.Icon">
                                    @_localizer[context.Text]
                                </MudNavLink>
                                }
                            }
                            else
                            {
                            @if (!context.Icon.IsNullOrWhiteSpace())
                                {
                                <MudIcon Icon="@context.Icon" Class="ml-0 mr-2" Color="@Color.Default" />
                                }
                            @if (!IsMini)
                                {
                                <MudListSubheader Class="@(CanExpand(context) ? "cursor-pointer" : "")" @onclick="() => OnExpandCollapseClick(context)">@_localizer[context.Text]</MudListSubheader>

                                <div class="apply-right">
                                    <MudTreeViewItemToggleButton Visible="CanExpand(context)" Expanded="context.IsExpanded" ExpandedChanged="() => OnExpandCollapseClick(context)" />
                                </div>
                                }
                                else
                                {
                                <MudDivider Class="mini-divider" />
                                }
                            }
                    </Content>
                </MudTreeViewItem>
                }
            </ItemTemplate>
        </MudTreeView>
    </MudNavMenu>

</div>
