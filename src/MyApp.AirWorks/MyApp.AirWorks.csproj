<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\MyApp.ServiceDefaults\MyApp.ServiceDefaults.csproj" />
    <CoworkeePackage Include="Coworkee.Bff" />
  </ItemGroup>

  <!-- the AirWorks client in ClientApp is built with Node.js into wwwroot; -p:SkipClientBuild=true leaves it out -->
  <ItemGroup>
    <Content Remove="wwwroot\**;ClientApp\**" />
    <None Remove="ClientApp\node_modules\**" />
    <ClientPackage Include="ClientApp\package.json;ClientApp\vendor\*.tgz" />
    <ClientSource Include="@(ClientPackage);ClientApp\src\**;ClientApp\index.html;ClientApp\vite.config.ts;ClientApp\tsconfig.json" />
  </ItemGroup>

  <Target Name="InstallClient" Condition="'$(SkipClientBuild)' != 'true'" Inputs="@(ClientPackage)" Outputs="ClientApp\node_modules\.package-lock.json">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="ClientApp" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="Build" DependsOnTargets="InstallClient" Condition="'$(SkipClientBuild)' != 'true'" Inputs="@(ClientSource)" Outputs="wwwroot\index.html">
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

  <Target Name="PublishClient" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_ClientFile Include="wwwroot\**" />
      <ResolvedFileToPublish Include="@(_ClientFile->'%(FullPath)')" RelativePath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
