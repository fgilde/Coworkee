{
  "Coworkee": {
    "Registration": {
      "RequireAddress": true,
      "AllowedEmails": [ "*" ],
      "Password": {
        "RequiredLength": 8,
        "RequireUppercase": true,
        "RequireLowercase": true,
        "RequireDigit": true,
        "RequireNonAlphanumeric": false
      },
      "RequireDocuments": true,
      "Documents": [
        {
          "Name": "Passport",
          "Description": "A scan or photo of your passport or identity card.",
          "ContentTypes": [ "application/zip*", "application/x-zip*", "audio/*", "application/pdf", "application/msword", "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.*", "image/*", "text/*" ],
          "MaxSize": 4000000
        },
        {
          "Name": "Certificate",
          "Description": "Qualifications and references that confirm your qualification.",
          "ContentTypes": [ "application/zip*", "application/x-zip*", "audio/*", "application/pdf", "application/msword", "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.*", "image/*", "text/*" ],
          "MaxSize": 4000000
        }
      ]
    },
    "Auth": {
      "Login": {
        "AllowUserName": true,
        "AllowedEmails": [ "*" ]
      }
    }
  }
}
