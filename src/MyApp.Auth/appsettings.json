{
  "Coworkee": {
    "Registration": {
      "RequireAddress": true,
      "AllowedEmails": [ "*" ],
      "Password": {
        "RequiredLength": 8,
        "RequireUppercase": true,
        "RequireLowercase": true,
        "RequireDigit": true,
        "RequireNonAlphanumeric": false
      },
      "RequireDocuments": true,
      "Documents": [
        {
          "Name": "Passport",
          "Description": "A scan or photo of your passport or identity card.",
          "Names": { "de": "Ausweis" },
          "Descriptions": { "de": "Ein Scan oder Foto Ihres Reisepasses oder Personalausweises." },
          "ContentTypes": [ "application/zip*", "application/x-zip*", "audio/*", "application/pdf", "application/msword", "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.*", "image/*", "text/*" ],
          "MaxSize": 4000000
        },
        {
          "Name": "Certificate",
          "Description": "Qualifications and references that confirm your qualification.",
          "Names": { "de": "Nachweise" },
          "Descriptions": { "de": "Zeugnisse und Referenzen, die Ihre Qualifikation bestätigen." },
          "ContentTypes": [ "application/zip*", "application/x-zip*", "audio/*", "application/pdf", "application/msword", "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.*", "image/*", "text/*" ],
          "MaxSize": 4000000
        }
      ]
    },
    "Auth": {
      "Login": {
        "AllowUserName": true,
        "AllowedEmails": [ "*" ]
      }
    }
  }
}
