<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="Model.Title" Label="Title" Required="true" MaxLength="200" data-testid="document-title" />
            <MudSelect T="Guid?" @bind-Value="Model.DocumentTypeId" Label="Type" Clearable="true">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="Model.Description" Label="Description" Lines="3" />
            <MudCheckBox @bind-Value="Model.IsPublic" Label="Visible to everyone who may view documents" />
            @if (Id is null)
            {
                <MudFileUpload T="IBrowserFile" @bind-Files="_file" Class="mt-2">
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AttachFile" OnClick="context.OpenFilePickerAsync" data-testid="choose-file">
                            @(_file?.Name ?? "Choose file")
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving" data-testid="save-document">
            @(Id is null ? "Upload" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>
