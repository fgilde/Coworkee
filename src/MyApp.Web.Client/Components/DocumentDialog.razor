@using MudBlazor.Extensions.Components
@using Coworkee.Client.Blazor.Components.Files
@using MyApp.Web.Client.Api
<MudDialog Class="@MudBlazor.Extensions.Helper.MudExCss.Classes.Dialog.Initial" ContentClass="d-flex flex-column">
    <TitleContent>
        <MudText Typo="Typo.h6">@L[Title]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="Model.Title" Label="@L["Title"]" Required="true" MaxLength="200" data-testid="document-title" />
            <MudSelect T="Guid?" @bind-Value="Model.DocumentTypeId" Label="@L["Type"]" Clearable="true">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid?" Value="type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="Model.Description" Label="@L["Description"]" Lines="3" />
            <MudCheckBox @bind-Value="Model.IsPublic" Label="@L["Visible to everyone who may view documents"]" />
            @if (Id is null)
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.End" Spacing="2" Class="mt-2" data-testid="document-source">
                    @if (_fileId is null)
                    {
                        <div data-testid="upload-file">
                            <MudExUploadEdit T="UploadableFile" @bind-UploadRequest="_file" AllowMultiple="false" AllowFolderUpload="false" AllowExternalUrl="false"
                                             MaxFileSize="MaxFileBytes" TextUploadFile="@L["Upload"]" ButtonVariant="Variant.Outlined" ButtonColor="Color.Default" ButtonsJustify="Justify.FlexStart"
                                             ExternalProviderRendering="ExternalProviderRendering.Images" ExternalPickerImageSize="@("30px")" />
                        </div>
                    }
                    @if (_canImport && _file is null)
                    {
                        <CoworkeeFilePicker @bind-Value="_fileId" />
                    }
                </MudStack>
            }
        </MudForm>
        @if (Document is { } document)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">@L["Preview"]</MudText>
            <div style="flex:1 1 auto;min-height:360px" data-testid="document-preview">
                <MudExFileDisplay Url="@Nav.Absolute(document.Id)" ContentType="@document.MimeType" FileName="@document.FileName" ShowFileName="false" Style="height:100%" />
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving" data-testid="save-document">
            @L[Id is null ? "Upload" : "Save"]
        </MudButton>
    </DialogActions>
</MudDialog>
