<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="Model.Name" Label="Name" Required="true" MaxLength="200" data-testid="product-name" />
            <MudSelect T="Guid" @bind-Value="Model.BrandId" Label="Brand" Required="true" RequiredError="Choose a brand." data-testid="product-brand">
                @foreach (var brand in _brands)
                {
                    <MudSelectItem T="Guid" Value="brand.Id">@brand.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="Model.Barcode" Label="Barcode" />
            <MudTextField @bind-Value="Model.Description" Label="Description" Lines="3" />
            <MudNumericField @bind-Value="Model.Rate" Label="Rate" Min="0m" Format="0.00" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
                @if (Model.ImageDataUrl is { } image)
                {
                    <MudAvatar Size="Size.Large"><MudImage Src="@image" Alt="Product image" /></MudAvatar>
                    <MudIconButton Icon="@Icons.Material.Outlined.Clear" Size="Size.Small" aria-label="Remove image" OnClick="() => Model.ImageDataUrl = null" />
                }
                <MudFileUpload T="IBrowserFile" Accept="image/*" FilesChanged="LoadImageAsync">
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Image" OnClick="context.OpenFilePickerAsync">Choose image</MudButton>
                    </CustomContent>
                </MudFileUpload>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" data-testid="save-product">Save</MudButton>
    </DialogActions>
</MudDialog>
