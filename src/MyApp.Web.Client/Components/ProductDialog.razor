<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L[Title]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="Model.Name" Label="@L["Name"]" Required="true" MaxLength="200" data-testid="product-name" />
            <MudSelect T="Guid" @bind-Value="Model.BrandId" Label="@L["Brand"]" Required="true" RequiredError="@L["Choose a brand."]" data-testid="product-brand">
                @foreach (var brand in _brands)
                {
                    <MudSelectItem T="Guid" Value="brand.Id">@brand.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="Model.Barcode" Label="@L["Barcode"]" />
            <MudTextField @bind-Value="Model.Description" Label="@L["Description"]" Lines="3" />
            <MudNumericField @bind-Value="Model.Rate" Label="@L["Rate"]" Min="0m" Format="0.00" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
                @if (Model.ImageDataUrl is { } image)
                {
                    <MudAvatar Size="Size.Large"><MudImage Src="@image" Alt="Product image" /></MudAvatar>
                    <MudIconButton Icon="@Icons.Material.Outlined.Clear" Size="Size.Small" aria-label="Remove image" OnClick="() => Model.ImageDataUrl = null" />
                }
                <MudFileUpload T="IBrowserFile" Accept="image/*" FilesChanged="LoadImageAsync">
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Image" OnClick="context.OpenFilePickerAsync">@L["Choose image"]</MudButton>
                    </CustomContent>
                </MudFileUpload>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" data-testid="save-product">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>
