<MudPaper Elevation="25" Class="d-flex flex-row align-center pt-6 pb-4" Style="height:100px" data-stat="@Label">
    <MudIcon Icon="@Icon" Color="@Color" Class="mx-4" Style="width:54px;height:54px" />
    <div>
        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-n1">@Label</MudText>
        <MudText Typo="Typo.h5">@Value</MudText>
    </div>
</MudPaper>
