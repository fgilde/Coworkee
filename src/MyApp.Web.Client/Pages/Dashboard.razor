@page "/dashboard"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + CatalogPermissions.Dashboards.View)]

<PageHeader Title="Dashboard" Description="Realtime updates and insights." />
<RealtimeSubscription Topic="type:Product" OnEvent="_ => LoadAsync()" />
<RealtimeSubscription Topic="type:Brand" OnEvent="_ => LoadAsync()" />
@if (_dashboard is not { } dashboard)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><StatTile Label="@L["Products"]" Value="dashboard.Products" Icon="@Icons.Material.Filled.ViewCarousel" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><StatTile Label="@L["Brands"]" Value="dashboard.Brands" Icon="@Icons.Material.Filled.PanoramaPhotosphereSelect" Color="Color.Secondary" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><StatTile Label="@L["Documents"]" Value="dashboard.Documents" Icon="@Icons.Material.Filled.AttachFile" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><StatTile Label="@L["Document Types"]" Value="dashboard.DocumentTypes" Icon="@Icons.Material.Filled.FileCopy" Color="Color.Secondary" /></MudItem>
        @if (dashboard.Users is { } users)
        {
            <MudItem xs="12" sm="6" md="3"><StatTile Label="@L["Registered Users"]" Value="users" Icon="@Icons.Material.Filled.Face" Color="Color.Success" /></MudItem>
        }
        @if (dashboard.Roles is { } roles)
        {
            <MudItem xs="12" sm="6" md="3"><StatTile Label="@L["Registered Roles"]" Value="roles" Icon="@Icons.Material.Filled.Groups" Color="Color.Warning" /></MudItem>
        }
        <MudItem xs="12" md="8">
            <MudPaper Elevation="25" Class="pa-4">
                <MudText Typo="Typo.h6">@L["Products per month"]</MudText>
                <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="_series" ChartLabels="_labels" Width="100%" Height="320px" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}
