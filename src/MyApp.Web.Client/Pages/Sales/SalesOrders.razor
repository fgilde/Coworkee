@page "/sales/orders"
@using Coworkee.Contracts.Data
@attribute [Authorize(Policy = PermissionPolicy.Prefix + SalesPermissions.Orders.View)]

<PageHeader Title="Sales Orders" Description="100,000 orders as a client entity: the browser keeps them and answers search, facets, sorting and grouping itself." />
<CoworkeeDataTable @ref="_table" T="SalesOrderDto" EntitySet="@EntitySet" Expand="@Expand" SearchFields="SearchFields" MultiSelection="true" ExportFileName="sales-orders"
                   DescribeItem="o => o.Number" CreateText="New order"
                   CreatePermission="@SalesPermissions.Orders.Create" EditPermission="@SalesPermissions.Orders.Edit" DeletePermission="@SalesPermissions.Orders.Delete"
                   OnCreate="CreateAsync" OnEdit="EditAsync" OnDelete="DeleteAsync" FacetLayout="FacetLayout.Panel" FacetSettings="FacetSettings">
    <Columns>
        <PropertyColumn Property="o => o.Number" Title="@L["Number"]" />
        <PropertyColumn Property="o => o.Customer!.Name" Title="@L["Customer"]" />
        <PropertyColumn Property="o => o.Status" Title="@L["Status"]">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">@L[EnumLabels.Of(context.Item.Status)]</MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="o => o.Channel" Title="@L["Channel"]">
            <CellTemplate>@L[EnumLabels.Of(context.Item.Channel)]</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="o => o.Region" Title="@L["Region"]" />
        <PropertyColumn Property="o => o.OrderDate" Title="@L["Order date"]" Format="d" />
        <PropertyColumn Property="o => o.Items" Title="@L["Items"]" />
        <PropertyColumn Property="o => o.Total" Title="@L["Total"]" Format="N2" AggregateDefinition="TotalSum" />
        <PropertyColumn Property="o => o.Options" Title="@L["Options"]" Sortable="false">
            <CellTemplate>
                @foreach (var option in OptionsOf(context.Item.Options))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@L[EnumLabels.Of(option)]</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="o => o.Paid" Title="@L["Paid"]">
            <CellTemplate>
                <MudIcon Icon="@(context.Item.Paid ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.HourglassEmpty)" Size="Size.Small"
                         Color="@(context.Item.Paid ? Color.Success : Color.Default)" />
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="SalesOrderDto" Sortable="false" Title="@L["Approval"]">
            <CellTemplate>
                @if (context.Item.Status is SalesOrderStatus.Open or SalesOrderStatus.Confirmed or SalesOrderStatus.Cancelled)
                {
                    <CoworkeeWorkflowActions EntityType="SalesOrders" EntityId="context.Item.Id" />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="SalesOrderDto" Sortable="false" Title="">
            <CellTemplate>
                @if (context.Item.Status is not (SalesOrderStatus.Cancelled or SalesOrderStatus.Delivered))
                {
                    <MudTooltip Text="@L["Cancel order"]">
                        <MudIconButton Icon="@Icons.Material.Outlined.Block" Size="Size.Small" OnClick="() => CancelAsync(context.Item)" data-testid="cancel-row" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</CoworkeeDataTable>
