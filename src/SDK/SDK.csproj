<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>CleanArchitectureBase.SDK</RootNamespace>
    <AssemblyName>CleanArchitectureBase.SDK</AssemblyName>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Title>CleanArchitectureBase.SDK</Title>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>CleanArchitectureBase.SDK</PackageId>
    <PackageVersion>0.0.0-dev</PackageVersion>
    <Authors>fgilde</Authors>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>Git</RepositoryType>
    <PackageProjectUrl>https://github.com/fgilde/Nextended</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fgilde/Nextended</RepositoryUrl>
    <Description>
      Provides a SDK for using API of CleanArchitectureBase
    </Description>
    <Copyright>Copyright © $(Authors) 2020-$([System.DateTime]::Now.Year)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>SDK,HTTP,Client,CleanArchitectureBase</PackageTags>
    <!--<PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>-->
  </PropertyGroup>

  <ItemGroup>
    <!--<PackageReference Include="Nerdbank.GitVersioning" Version="3.5.119">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>-->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj">
      <CopyLocal></CopyLocal>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyPackage" AfterTargets="Build">
    <ItemGroup>
      <SdkPackageFiles Include="$(ProjectDir)bin/$(Configuration)/*.nupkg" />
    </ItemGroup>
    <Copy SourceFiles="@(SdkPackageFiles)" DestinationFolder="$(SolutionDir)src/Server/wwwroot/sdk" />
  </Target>

</Project>
