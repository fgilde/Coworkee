{

  "StructureGenerations": [
    {
      "ModelType": "Class",
      "SourceFile": "/appsettings.json", // Path to the source file to generate from
      "RootClassName": "ServerConfiguration", // Name of the root class to generate
      "Namespace": "Coworkee.Application.Configurations", // Namespace for the generated class
      "Ignore": [ // Ignore for example to create a partial class with the same name or for whatever reason
        "PublicSettings.Endpoints",
        "PublicSettings.LoginSettings.LoginMode"
      ], 
      "OutputPath": "../Application/Configurations/Generated/"
    }
  ]
}