<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }

        .appbar {
            height: 60px;
            background-color: #373740;
            color: white;
            padding: 0px;
            text-align: center;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            margin-top: 50px;
            margin-bottom: 20px;
            width: 100%;
            text-align: center;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .app-name {
            margin-left: 5px;
            margin-top: 25px;
        }

        .content {
            /* width: 80%;
                    margin: 20px auto; */
            width: 100%;
            background-color: white;
            padding: 20px;
            box-sizing: border-box;
            word-wrap: break-word;
            font-size: 11pt;
        }

        .footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 10px;
            position: fixed;
            bottom: 0;
            width: 100%;
        }

        a {
            color: #1E88E5;
            text-decoration: none;
        }

        .btn {
            background-color: #1E88E5;
            color: white;
            padding: 10px;
            border-radius: 3px;
            text-transform: uppercase;
        }

        .detail-table {
            width: 100%;
            border-collapse: collapse;
        }

            .detail-table th, .detail-table td {
                border: 1px solid #ddd;
                padding: 8px;
            }

            .detail-table tr:nth-child(even) {
                background-color: #f2f2f2;
            }

            .detail-table tr:nth-child(odd) {
                background-color: white;
            }

            .detail-table th {
                padding-top: 12px;
                padding-bottom: 12px;
                text-align: left;
                background-color: #1E88E5;
                color: white;
            }

            .detail-table td:first-child {
                font-weight: bold;
            }
    </style>
</head>
<body>
    <div class="appbar">
        <h4 class="app-name">
            Coworkee
        </h4>
    </div>



    <div class="content">
        @RenderBody()
    </div>

    <div class="footer">
        @Include("Footer", Model)
    </div>
</body>
</html>